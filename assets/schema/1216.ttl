                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:service_cost_source ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:service_create_time ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:dateTime
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:service_customer_type ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:service_estimated_cost ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:decimal
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:service_id ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:service_initiator ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:service_initiator_dept ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:service_mode ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:service_stage_status ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ;
           owl:hasKey ( ex:service_id
                      ) ;
           ex:description "服务申请可能包含技术支持、培训、运维、二次开发等服务" ;
           ex:rules """一个项目可能有多个服务申请；
服务申请需要的费用依赖于项目预算；
服务发起时，需要预估费用""" ;
           ex:source_mapping "原始表6 服务申请编号" ;
           rdfs:comment "即外包服务申请，某个项目需要外包支持时，由项目经理发起，寻找外包服务商" ;
           rdfs:label "服务"@zh .


###  http://datahub/cost#service_catalogy
ex:service_catalogy rdf:type owl:Class ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty ex:service_category_id ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty ex:service_category_name ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ;
                    owl:hasKey ( ex:service_category_id
                               ) ;
                    ex:description """主要用于对外（服务商）说明任务内容；
""" ;
                    ex:rules "公司内部对服务做分类统计时，除非明确提出要按照此字段统计，否则不首选该字段；" ;
                    ex:source_mapping "原始表6 服务类目" ;
                    rdfs:comment "一种将服务内容分类的方式，在发起服务申请与任务时按此分类" ;
                    rdfs:label "服务类目"@zh .


###  http://datahub/cost#service_type
ex:service_type rdf:type owl:Class ;
                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                  owl:onProperty ex:service_type_id ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ex:service_type_level ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty ex:service_type_name ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:string
                                ] ;
                owl:hasKey ( ex:service_type_id
                           ) ;
                ex:description """包含两个服务类型级别，一级服务类型下包含多个二级服务类型；
枚举如下
-专项服务（包含的二级服务类型：专项服务-HW、专项服务-灯塔、专项服务-升级）
-标准服务（包含的二级服务类型：标准部署与运维、培训服务、标准账号对接、远程支持服务）
-定制服务（包含的二级服务类型：定制运维、二次开发、非标账号对接、客户端系统集成服务、客户端现场安装、培训及内容定制、私有云非标部署、驻场服务）""" ;
                ex:rules "公司内部主要按此对外包服务做分类统计，可以从一级服务类型维度统计，也可以从二级服务类型维度统计；" ;
                ex:source_mapping "原始表X 一级服务类型、二级服务类型" ;
                rdfs:comment "一种将服务内容分类的方式，在发起项目预算申请时按此分类" ;
                rdfs:label "服务类型"@zh .


###  http://datahub/cost#task
ex:task rdf:type owl:Class ;
        rdfs:subClassOf [ rdf:type owl:Restriction ;
                          owl:onProperty ex:contract_entity ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty ex:service_provider ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty ex:task_amount ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:decimal
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty ex:task_creator ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty ex:task_id ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty ex:task_name ;
                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                          owl:onDataRange xsd:string
                        ] ;
        owl:hasKey ( ex:task_id
                   ) ;
        ex:description """在服务申请通过之后，由项目向中标的服务商发起任务，任务中说明服务的具体内容，并与服务商形成合同关系；
""" ;
        ex:rules """项目整包时，任务金额为即此次外包实际支出的费用；
人员外包时，要根据任务对应的外包工作验收金额计算实际成本""" ;
        ex:source_mapping "原始表3+原始表5 任务书编号" ;
        rdfs:comment "即向外部服务商派发的实际任务" ;
        rdfs:label "任务"@zh .


