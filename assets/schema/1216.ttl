                    ex:rules """在年度内，所有项目在某一类外包服务上发生的费用总和，应不超过公司预算
""" ;
                    ex:source_mapping "原始表6 预算映射id、二级预算id" ;
                    rdfs:comment "公司为某一类服务提前圈定的年度预算"@zh ;
                    rdfs:label "公司预算"@zh .


