@prefix : <http://datahub/cost#> .
@prefix ex: <http://datahub/cost#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://datahub/cost#> .

<http://datahub/cost> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://datahub/cost#description
ex:description rdf:type owl:AnnotationProperty ;
               rdfs:comment "具体介绍某个字段的含义、作用以及引申的逻辑关系"@zh .


###  http://datahub/cost#examples
ex:examples rdf:type owl:AnnotationProperty ;
            rdfs:comment "某个字段的示例"@zh .


###  http://datahub/cost#rules
ex:rules rdf:type owl:AnnotationProperty ;
         ex:rules "说明某个字段在推理过程中有哪些规则、该如何使用"@zh .


###  http://datahub/cost#source_mapping
ex:source_mapping rdf:type owl:AnnotationProperty ;
                  ex:rules "说明从数据源中获取实例的规则"@zh .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://datahub/cost#belongs_to_level_1_service_type
ex:belongs_to_level_1_service_type rdf:type owl:ObjectProperty ,
                                            owl:FunctionalProperty ;
                                   rdfs:domain ex:service_type ;
                                   rdfs:range ex:service_type ;
                                   ex:examples "标准账号对接  belongs to level 1 service type 标准服务" ;
                                   ex:source_mapping """原始表X服务类型
二级服务类型 为domain
一级服务类型 为range""" ;
                                   rdfs:comment "某个二级服务类型，归属于哪个一级服务类型" ;
                                   rdfs:label "归属一级服务类型" .


###  http://datahub/cost#belongs_to_parent_corporate_budget
ex:belongs_to_parent_corporate_budget rdf:type owl:ObjectProperty ,
                                               owl:FunctionalProperty ;
                                      rdfs:domain ex:corporate_budget ;
                                      rdfs:range ex:corporate_budget ;
                                      ex:examples "25Q4-DKYX-V4.3 belongs to parent corporate budget 25T-TBG-Q4-PRO-V4.3" ;
                                      ex:source_mapping """原始表6
项目预算ID 为domain
同行的二级预算ID 为range""" ;
                                      rdfs:comment "某个三级公司预算，归属于哪个二级公司预算" ;
                                      rdfs:label "所属上级公司预算" .


###  http://datahub/cost#belongs_to_parent_department
ex:belongs_to_parent_department rdf:type owl:ObjectProperty ,
                                         owl:FunctionalProperty ;
                                rdfs:domain ex:department ;
                                rdfs:range ex:department ;
                                ex:examples "军工一组 belongs to parent department 大客特种" ;
                                ex:source_mapping """原始表X部门
某个实例 为domain
其同行左侧列的实例 为range""" ;
                                rdfs:comment "某个子部门的上级部门是哪个" ;
                                rdfs:label "归属上级部门" .


###  http://datahub/cost#belongs_to_product_catalogy
ex:belongs_to_product_catalogy rdf:type owl:ObjectProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:domain ex:product ;
                               rdfs:range ex:product_catelogy ;
                               ex:source_mapping """\"所有产品为domain
range先从原始表4 E列对应的T列成本产品线找最多的一个
为空的话去原始表X日报明细 I列对应的U列找最多的一个\"""" ;
                               rdfs:comment "某个产品在计算成本时，归属于哪个产品类别" ;
                               rdfs:label "所属产品成本类别" .


###  http://datahub/cost#belongs_to_product_line
ex:belongs_to_product_line rdf:type owl:ObjectProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:domain ex:product ;
                           rdfs:range ex:produce_line ;
                           ex:source_mapping "原始表X 日报明细-日报明细 I列产品类型为domain J列产品条线为range" ;
                           rdfs:comment "某个产品属于哪个产品条线" ;
                           rdfs:label "归属产品条线" .


###  http://datahub/cost#belongs_to_service_catalogy
ex:belongs_to_service_catalogy rdf:type owl:ObjectProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:domain ex:service ;
                               rdfs:range ex:service_catalogy ;
                               ex:source_mapping """\"原始表6
服务类目 为range
同行的服务申请编号 为domain\"""" ;
                               rdfs:comment "某个服务申请时的服务类目，用于对外包服务商说明的任务内容分类" ;
                               rdfs:label "所属服务类目" .


###  http://datahub/cost#contain_product
ex:contain_product rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain ex:order ;
                   rdfs:range ex:product ;
                   ex:examples "S00540771 contain product WPS 365教育高级版" ;
                   ex:source_mapping """原始表4
订单号 为domain
同行的产品名称 为range""" ;
                   rdfs:comment "某个订单中包含什么产品，即客户想要购买什么产品" ;
                   rdfs:label "包含产品" .


###  http://datahub/cost#contain_projects
ex:contain_projects rdf:type owl:ObjectProperty ,
                             owl:InverseFunctionalProperty ;
                    rdfs:domain ex:customer ;
                    rdfs:range ex:project ;
                    ex:source_mapping """\"原始表X PMS
A列项目编号 为range
同行的 G列客户编号 为domain\"""" ;
                    rdfs:comment "客户名下都包含哪些项目" ;
                    rdfs:label "包含项目" .


###  http://datahub/cost#contractor_work_belongs_to_product
ex:contractor_work_belongs_to_product rdf:type owl:ObjectProperty ,
                                               owl:FunctionalProperty ;
                                      rdfs:domain ex:contractor_work ;
                                      rdfs:range ex:product ;
                                      ex:source_mapping "原始表X 服务商日报-工程师日报 A日报明细名称作为domain、Q产品名称（项目产品库）为range" ;
                                      rdfs:comment "外包工作是针对哪个产品产生的" ;
                                      rdfs:label "外包工作涉及产品" .


###  http://datahub/cost#contractor_work_belongs_to_task
ex:contractor_work_belongs_to_task rdf:type owl:ObjectProperty ,
                                            owl:FunctionalProperty ;
                                   rdfs:domain ex:contractor_work ;
                                   rdfs:range ex:task ;
                                   ex:source_mapping "原始表X 服务商日报-工程师日报 A日报明细名称作为domain、AO任务书编号 为range" ;
                                   rdfs:comment "外包工作属于哪个外包任务" ;
                                   rdfs:label "外包工作归属任务" .


###  http://datahub/cost#customer_belongs_to_department
ex:customer_belongs_to_department rdf:type owl:ObjectProperty ,
                                           owl:FunctionalProperty ;
                                  rdfs:domain ex:customer ;
                                  rdfs:range ex:department ;
                                  ex:source_mapping """\"原始表X PMS
P列客户归属部门为range
同行的 G列客户编号 为domain\"""" ;
                                  rdfs:comment "客户由公司内的哪个部门负责，最终外包服务成本也按照此部门计算归属" ;
                                  rdfs:label "客户由某个部门负责" .


###  http://datahub/cost#depend_on_level_2_corporate_budget
ex:depend_on_level_2_corporate_budget rdf:type owl:ObjectProperty ,
                                               owl:FunctionalProperty ;
                                      rdfs:domain ex:service ;
                                      rdfs:range ex:corporate_budget ;
                                      ex:examples "PR-20250926-0005 depend on level 2 corporate budget 25T-TBG-Q4-PRO-V4.3" ;
                                      ex:source_mapping """原始表6 
二级预算ID 为range
同行的 服务申请编号 为domain""" ;
                                      rdfs:comment "某个服务的费用计划依赖哪个预算级别为“二级”的公司预算" ;
                                      rdfs:label "依赖公司二级预算" .


###  http://datahub/cost#depend_on_level_3_corporate_budget
ex:depend_on_level_3_corporate_budget rdf:type owl:ObjectProperty ,
                                               owl:FunctionalProperty ;
                                      rdfs:domain ex:service ;
                                      rdfs:range ex:corporate_budget ;
                                      ex:examples "PR-20250926-0005 depend on level 3 corporate budget 25Q4-DKYX-V4.3" ;
                                      ex:source_mapping """原始表6 
预算映射ID 为range
同行的 服务申请编号 为domain""" ;
                                      rdfs:comment "某个服务申请的费用计划依赖哪个预算级别为“三级”的公司预算" ;
                                      rdfs:label "依赖公司三级预算" .


###  http://datahub/cost#depend_on_opportunity
ex:depend_on_opportunity rdf:type owl:ObjectProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:domain ex:project_budget ;
                         rdfs:range ex:opportunity ;
                         owl:propertyDisjointWith ex:depend_on_order ;
                         ex:examples "PBD＃20250100035 depend on opportunity PR-00167290" ;
                         ex:source_mapping """原始表4 \"订单号”若没有值且“商机号”有值情况下
取“项目预算明细编号”为domain
取同行“商机号”为range""" ;
                         rdfs:comment "项目申请该预算，因为客户已产生了商机" ;
                         rdfs:label "项目预算依赖商机" .


###  http://datahub/cost#depend_on_order
ex:depend_on_order rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain ex:project_budget ;
                   rdfs:range ex:order ;
                   ex:examples "PBD＃20250600001 depend on order S00292777" ;
                   ex:source_mapping """原始表4 \"订单号”若有值
取“项目预算明细编号”为domain
取同行“订单号”为range""" ;
                   rdfs:comment "项目申请该预算，因为客户已产生了实际订单" ;
                   rdfs:label "项目预算依赖订单" .


###  http://datahub/cost#depend_on_project_budget
ex:depend_on_project_budget rdf:type owl:ObjectProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain ex:service ;
                            rdfs:range ex:project_budget ;
                            ex:examples "PR-20250926-0005 depend on project budget PBD＃20250100035" ;
                            ex:source_mapping """原始表4 
项目预算明细编号 为range
同行的 服务申请编号 为domain""" ;
                            rdfs:comment "某个服务申请的费用计划依赖哪个项目预算" ;
                            rdfs:label "依赖项目预算" .


###  http://datahub/cost#employee_work_belongs_to_service_type
ex:employee_work_belongs_to_service_type rdf:type owl:ObjectProperty ,
                                                  owl:FunctionalProperty ;
                                         rdfs:domain ex:employee_work ;
                                         rdfs:range ex:service_type ;
                                         ex:source_mapping """\"原始表X 日报明细-日报明细
X列 服务项目 为range
A列编号 为domain
其中部分服务项目要做转化
私有云升级-----专项服务-升级
标准培训服务-----标准培训
远程技术支持------远程支持服务\"""" ;
                                         rdfs:comment "正编工作的内容属于什么服务类型" ;
                                         rdfs:label "正编工作所属服务类型" .


###  http://datahub/cost#generate_employee_work
ex:generate_employee_work rdf:type owl:ObjectProperty ,
                                   owl:InverseFunctionalProperty ;
                          rdfs:domain ex:project ;
                          rdfs:range ex:employee_work ;
                          ex:source_mapping """原始表X M列项目编号为domain
A列编号为range""" ;
                          rdfs:comment "当某个正编员工在某个项目产生工时投入时，即记录一条正编工作，工时会按照公式计算为金额，作为项目成本" ;
                          rdfs:label "项目产生正编工作" .


###  http://datahub/cost#generate_opportunity
ex:generate_opportunity rdf:type owl:ObjectProperty ,
                                 owl:InverseFunctionalProperty ;
                        rdfs:domain ex:customer ;
                        rdfs:range ex:opportunity ;
                        ex:source_mapping """\"原始表4 
商机号 为range
同行的 客户名称 匹配到对应的客户ID 为domain\"""" ;
                        rdfs:comment "客户会产生哪个商机，有意向购买我们产品" ;
                        rdfs:label "客户产生商机" .


###  http://datahub/cost#generate_order
ex:generate_order rdf:type owl:ObjectProperty ,
                           owl:InverseFunctionalProperty ;
                  rdfs:domain ex:opportunity ;
                  rdfs:range ex:order ;
                  ex:source_mapping """原始表4 
订单号 为range
同行的 客户名称 为domain""" ;
                  rdfs:comment "客户实际需要购买某个产品时，由销售负责人根据商机，在公司内部产生订单" ;
                  rdfs:label "客户产生订单" .


###  http://datahub/cost#generate_project_budget
ex:generate_project_budget rdf:type owl:ObjectProperty ,
                                    owl:InverseFunctionalProperty ;
                           rdfs:domain ex:project ;
                           rdfs:range ex:project_budget ;
                           ex:source_mapping """原始表4 
项目预算明细编号 为range
同行的 项目名称 匹配到的项目ID 为domain""" ;
                           rdfs:comment "某个项目为了后续潜在的外包服务，提前申请的预算" ;
                           rdfs:label "项目产生项目预算" .


###  http://datahub/cost#generate_single-customer_service
ex:generate_single-customer_service rdf:type owl:ObjectProperty ,
                                             owl:InverseFunctionalProperty ;
                                    rdfs:domain ex:project ;
                                    rdfs:range ex:service ;
                                    ex:source_mapping """服务为单客户时
原始表4 
服务申请编号为range
同行的 项目名称 匹配到的项目ID 为domain\"""" ;
                                    rdfs:comment "某个项目需要培训、定制等服务时，产生的外包服务申请，可能是单客户项目整包，也可能是单客户人员外包" ;
                                    rdfs:label "项目产生单客户外包服务" .


###  http://datahub/cost#generate_task
ex:generate_task rdf:type owl:ObjectProperty ,
                          owl:InverseFunctionalProperty ;
                 rdfs:domain ex:service ;
                 rdfs:range ex:task ;
                 ex:source_mapping """\"原始表3、原始表5
任务书编号 为range
同行的 服务申请编号 为domain\"""" ;
                 rdfs:comment "某个服务申请通过后，基于这个申请产生的任务" ;
                 rdfs:label "外包服务产生任务" .


###  http://datahub/cost#multi-customer_service_belongs_to_department
ex:multi-customer_service_belongs_to_department rdf:type owl:ObjectProperty ,
                                                         owl:FunctionalProperty ;
                                                rdfs:domain ex:service ;
                                                rdfs:range ex:department ;
                                                ex:source_mapping """\"服务为多客户服务时
原始表6 K列项目负责人部门\"""" ;
                                                rdfs:comment "多客户服务产生的费用成本归属到公司哪个部门" ;
                                                rdfs:label "多客户外包服务成本归属部门" .


###  http://datahub/cost#order_belongs_to_department
ex:order_belongs_to_department rdf:type owl:ObjectProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:domain ex:order ;
                               rdfs:range ex:department ;
                               ex:examples "S00540771 order belongs to department 教育销售华东组" ;
                               ex:source_mapping """原始表4
订单号 为domain
根据服务申请编号，在原始表6寻找订单/商机归属部门 为range""" ;
                               rdfs:comment "主某个订单由公司内的哪个部门负责，通常与订单所属客户的负责部门相同" ;
                               rdfs:label "订单由某个部门负责" .


###  http://datahub/cost#product_involved_in_employee_work
ex:product_involved_in_employee_work rdf:type owl:ObjectProperty ,
                                              owl:FunctionalProperty ;
                                     rdfs:domain ex:employee_work ;
                                     rdfs:range ex:product ;
                                     ex:source_mapping """原始表X 日报明细-日报明细
I列 产品类型 为range
A列编号 为domain""" ;
                                     rdfs:comment "正编工作的内容主要是对什么产品发生的" ;
                                     rdfs:label "正编工作涉及产品" .


###  http://datahub/cost#product_involved_in_service
ex:product_involved_in_service rdf:type owl:ObjectProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:domain ex:service ;
                               rdfs:range ex:product ;
                               ex:source_mapping "原始表4 E列产品名称为range、A列服务申请为domain" ;
                               rdfs:comment "外包服务主要针对哪个产品，项目整包时，对应的任务即针对此产品" ;
                               rdfs:label "外包服务涉及产品" .


###  http://datahub/cost#project-based_task_belongs_to_product_catalogy
ex:project-based_task_belongs_to_product_catalogy rdf:type owl:ObjectProperty ,
                                                           owl:FunctionalProperty ;
                                                  rdfs:domain ex:task ;
                                                  rdfs:range ex:product_catelogy ;
                                                  ex:source_mapping """\"原始表3 （这个表里本身都是整包的任务）
任务书编号 为domain
根据同行的服务申请编号，在原始表4找到对应的T列“成本产品线”为range\"""" ;
                                                  rdfs:comment "当任务对应的服务为项目整包时，任务产生的成本归属到哪个产品类别" ;
                                                  rdfs:label "整包任务费用归属产品类别" .


###  http://datahub/cost#project-based_task_belongs_to_service_type
ex:project-based_task_belongs_to_service_type rdf:type owl:ObjectProperty ,
                                                       owl:FunctionalProperty ;
                                              rdfs:domain ex:task ;
                                              rdfs:range ex:service_type ;
                                              ex:source_mapping """\"原始表3 项目任务书
F列任务书编号 为domain
对应E列服务申请 在原始表4中对应K列 服务类型（预算） 为range\"""" ;
                                              rdfs:comment "某个整包任务归属于我们公司内部定义的哪种服务类型" ;
                                              rdfs:label "整包任务归属服务类型" .


###  http://datahub/cost#project_belongs_to_department
ex:project_belongs_to_department rdf:type owl:ObjectProperty ,
                                          owl:FunctionalProperty ;
                                 rdfs:domain ex:project ;
                                 rdfs:range ex:department ;
                                 ex:source_mapping """\"原始表X PMS
AB列 当前负责人所属四级部门 为range
A列项目编号 为domain\"""" ;
                                 rdfs:comment "项目由公司内的哪个部门负责，通常为项目负责人所在的部门" ;
                                 rdfs:label "项目由某个部门负责" .


###  http://datahub/cost#project_generate_contractor_work
ex:project_generate_contractor_work rdf:type owl:ObjectProperty ,
                                             owl:InverseFunctionalProperty ;
                                    rdfs:domain ex:project ;
                                    rdfs:range ex:contractor_work ;
                                    ex:source_mapping "原始表X 服务商日报-工程师日报 AA主项目编号作为domain、A日报明细名称作为range" ;
                                    rdfs:comment "当某个外包员工在某个项目产生工时投入时，即记录一条外包工作，外包工作经验收后的成本可计入项目成本" ;
                                    rdfs:label "项目产生外包工作" .


###  http://datahub/cost#task_generate_contractor_work_acceptance
ex:task_generate_contractor_work_acceptance rdf:type owl:ObjectProperty ,
                                                     owl:InverseFunctionalProperty ;
                                            rdfs:domain ex:task ;
                                            rdfs:range ex:contractor_work_acceptance ;
                                            ex:source_mapping "原始表11 C列任务书编号为domain、A列为range" ;
                                            rdfs:comment "对哪个外包任务进行了月度验收" ;
                                            rdfs:label "外包任务发生月度验收" .


#################################################################
#    Data properties
#################################################################

###  http://datahub/cost#Task_Engineer_Total_Price
ex:Task_Engineer_Total_Price rdf:type owl:DatatypeProperty ,
                                      owl:FunctionalProperty ;
                             rdfs:domain ex:task ;
                             rdfs:range xsd:decimal ;
                             ex:source_mapping "原始表5 签约状态 Z列总金额" ;
                             rdfs:comment "仅人员外包的任务涉及，指这次任务需要外包工程师投入的预估总价（按人天计算）" ;
                             rdfs:label "任务工程师总价" .


###  http://datahub/cost#Task_Engineer_Total_Service_Hours
ex:Task_Engineer_Total_Service_Hours rdf:type owl:DatatypeProperty ,
                                              owl:FunctionalProperty ;
                                     rdfs:domain ex:task ;
                                     rdfs:range xsd:integer ;
                                     ex:source_mapping "原始表5 签约状态 Y列服务总人天" ;
                                     rdfs:label "任务工程师服务总工时" .


###  http://datahub/cost#Task_Engineer_Unit_Price
ex:Task_Engineer_Unit_Price rdf:type owl:DatatypeProperty ,
                                     owl:FunctionalProperty ;
                            rdfs:domain ex:task ;
                            rdfs:range xsd:decimal ;
                            ex:source_mapping "原始表5 签约状态 X列单价" ;
                            rdfs:comment "仅人员外包的任务涉及，指派发的外包工程师工时单价（按人天计算）" ;
                            rdfs:label "任务工程师单价" .


###  http://datahub/cost#approval_status
ex:approval_status rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain ex:service ;
                   rdfs:range xsd:string ;
                   ex:examples "审批通过" ;
                   ex:source_mapping "原始表6 审批状态" ;
                   rdfs:comment "服务申请是否已经在公司内审批通过" ;
                   rdfs:label "审批状态" ;
                   owl:versionInfo 1124 .


###  http://datahub/cost#contract_entity
ex:contract_entity rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain ex:task ;
                   rdfs:range xsd:string ;
                   ex:examples "北京金山办公软件股份有限公司" ;
                   ex:source_mapping "原始表3、原始表5 我司签约主体" ;
                   rdfs:comment "与服务商签约合同的是我司的哪家分公司" ;
                   rdfs:label "签约主体" .


