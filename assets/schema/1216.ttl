###  http://datahub/cost#tast_Project_Phase
ex:tast_Project_Phase rdf:type owl:DatatypeProperty ,
                               owl:FunctionalProperty ;
                      rdfs:domain ex:task ;
                      rdfs:range xsd:string ;
                      ex:source_mapping """\"仅针对项目整包的任务
查找与归属日期最近的正编工作，取其对应的项目阶段，若有多个阶段则取最后的；若找不到，则取对应项目的项目阶段\"""" ;
                      rdfs:comment """\"任务发起时，项目所处的阶段。仅项目整包任务的成本按此阶段计算。按照项目的发展顺序，枚举如下
-需求交流
-方案确认
-推动签约
-投产阶段
-推广验收
-运维阶段\"""" ;
                      rdfs:label "任务所属项目阶段" .


