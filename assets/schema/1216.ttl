ex:project rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty ex:pj_leader ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:pj_manager ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:pj_starttime ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:date
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:pj_trace ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:pj_type ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:project_id ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty ex:project_name ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ;
           owl:hasKey ( ex:project_id
                      ) ;
           ex:description """通过项目向客户交付产品，项目有不同阶段状态，按顺序包括
-售前交流 
-POC阶段
-签约阶段
-投产阶段
-推广验收
-运维阶段""" ;
           ex:rules """一个客户可能会有多个项目；
多个项目中包含的产品有可能不同，也有可能相同；
所有外包服务都必须基于项目发起的；""" ;
           ex:source_mapping "原始表PMS 项目编号 且排除I列为“公共项目”的" ;
           rdfs:comment "我们为客户交付一系列产品的“项目”" ;
           rdfs:label "项目"@zh .


###  http://datahub/cost#project_budget
ex:project_budget rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty ex:project_budget_amount ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:decimal
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ex:project_budget_dependency_type ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty ex:project_budget_id ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] ;
                  owl:hasKey ( ex:project_budget_id
                             ) ;
                  ex:description """考虑到项目后续可能会需要外部服务商支持，项目经理可以提前申请预算；
发起服务申请时，即依赖该预算；""" ;
                  ex:rules """一个预算可以被同项目的多个服务申请依赖；
正常情况下，这些被某个项目预算依赖的所有服务的预估费用总和应不超过项目预算金额""" ;
                  ex:source_mapping "原始表4 项目预算明细编号" ;
                  rdfs:comment "项目为可能发生的外部服务提前申请的预算" ;
                  rdfs:label "项目预算"@zh .


