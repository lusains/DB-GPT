                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty ex:dept_level ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onDataRange xsd:string
                              ] ;
              owl:hasKey ( ex:dept_id
                         ) ;
              ex:description "可能有多级，多级部门的完整路径表示为：XX/XX/XX/XX" ;
              ex:rules """所有员工角色，如项目负责人、项目经理、销售等，都应属于某个部门；
可根据某一个部门，查找其上级部门；
如果未按照XX/XX/XX/XX描述完整部门层级时，需按照部门名称寻找其父部门与子部门""" ;
              ex:source_mapping "原始表X 一级部门、二级部门、三级部门、四级部门" ;
              rdfs:comment "公司内部的部门" ;
              rdfs:label "部门"@zh .


