               ex:examples "187400" ;
               ex:source_mapping "原始表3 项目金额（BI用）、 原始表5 N列服务总金额（0609）" ;
               rdfs:comment """\"对于整包任务，即为任务实际花费的金额，差旅费用已计算在内，只有该金额才实际发生了，可作为整包服务的成本计算；
对于人员外包任务，该项仅为预估的成本，包含预估的工程师总价与差旅费用，实际发生的成本需要按照任务每个月对应的任务验收金额去计算\"""" ;
               rdfs:label "任务金额" .


###  http://datahub/cost#task_approval_status
ex:task_approval_status rdf:type owl:DatatypeProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain ex:task ;
