{"content": "@prefix : <http://datahub/cost#> .\n@prefix ex: <http://datahub/cost#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix xml: <http://www.w3.org/XML/1998/namespace> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@base <http://datahub/cost#> .\n\n<http://datahub/cost> rdf:type owl:Ontology .\n\n#################################################################\n#    Annotation properties\n#################################################################\n\n###  http://datahub/cost#description\nex:description rdf:type owl:AnnotationProperty ;\n               rdfs:comment \"\u5177\u4f53\u4ecb\u7ecd\u67d0\u4e2a\u5b57\u6bb5\u7684\u542b\u4e49\u3001\u4f5c\u7528\u4ee5\u53ca\u5f15\u7533\u7684\u903b\u8f91\u5173\u7cfb\"@zh .\n\n\n###  http://datahub/cost#examples\nex:examples rdf:type owl:AnnotationProperty ;\n            rdfs:comment \"\u67d0\u4e2a\u5b57\u6bb5\u7684\u793a\u4f8b\"@zh .\n\n\n###  http://datahub/cost#rules\nex:rules rdf:type owl:AnnotationProperty ;\n         ex:rules \"\u8bf4\u660e\u67d0\u4e2a\u5b57\u6bb5\u5728\u63a8\u7406\u8fc7\u7a0b\u4e2d\u6709\u54ea\u4e9b\u89c4\u5219\u3001\u8be5\u5982\u4f55\u4f7f\u7528\"@zh .\n\n\n###  http://datahub/cost#source_mapping\nex:source_mapping rdf:type owl:AnnotationProperty ;\n                  ex:rules \"\u8bf4\u660e\u4ece\u6570\u636e\u6e90\u4e2d\u83b7\u53d6\u5b9e\u4f8b\u7684\u89c4\u5219\"@zh .\n\n\n#################################################################\n#    Datatypes\n#################################################################\n\n###  http://www.w3.org/2001/XMLSchema#date\nxsd:date rdf:type rdfs:Datatype .\n\n\n#################################################################\n#    Object Properties\n#################################################################\n\n###  http://datahub/cost#belongs_to_level_1_service_type\nex:belongs_to_level_1_service_type rdf:type owl:ObjectProperty ,\n                                            owl:FunctionalProperty ;\n                                   rdfs:domain ex:service_type ;\n                                   rdfs:range ex:service_type ;\n                                   ex:examples \"\u6807\u51c6\u8d26\u53f7\u5bf9\u63a5  belongs to level 1 service type \u6807\u51c6\u670d\u52a1\" ;\n                                   ex:source_mapping \"\"\"\u539f\u59cb\u8868X\u670d\u52a1\u7c7b\u578b\n\u4e8c\u7ea7\u670d\u52a1\u7c7b\u578b \u4e3adomain\n\u4e00\u7ea7\u670d\u52a1\u7c7b\u578b \u4e3arange\"\"\" ;\n                                   rdfs:comment \"\u67d0\u4e2a\u4e8c\u7ea7\u670d\u52a1\u7c7b\u578b\uff0c\u5f52\u5c5e\u4e8e\u54ea\u4e2a\u4e00\u7ea7\u670d\u52a1\u7c7b\u578b\" ;\n                                   rdfs:label \"\u5f52\u5c5e\u4e00\u7ea7\u670d\u52a1\u7c7b\u578b\" .\n\n\n###  http://datahub/cost#belongs_to_parent_corporate_budget\nex:belongs_to_parent_corporate_budget rdf:type owl:ObjectProperty ,\n                                               owl:FunctionalProperty ;\n                                      rdfs:domain ex:corporate_budget ;\n                                      rdfs:range ex:corporate_budget ;\n                                      ex:examples \"25Q4-DKYX-V4.3 belongs to parent corporate budget 25T-TBG-Q4-PRO-V4.3\" ;\n                                      ex:source_mapping \"\"\"\u539f\u59cb\u88686\n\u9879\u76ee\u9884\u7b97ID \u4e3adomain\n\u540c\u884c\u7684\u4e8c\u7ea7\u9884\u7b97ID \u4e3arange\"\"\" ;\n                                      rdfs:comment \"\u67d0\u4e2a\u4e09\u7ea7\u516c\u53f8\u9884\u7b97\uff0c\u5f52\u5c5e\u4e8e\u54ea\u4e2a\u4e8c\u7ea7\u516c\u53f8\u9884\u7b97\" ;\n                                      rdfs:label \"\u6240\u5c5e\u4e0a\u7ea7\u516c\u53f8\u9884\u7b97\" .\n\n\n###  http://datahub/cost#belongs_to_parent_department\nex:belongs_to_parent_department rdf:type owl:ObjectProperty ,\n                                         owl:FunctionalProperty ;\n                                rdfs:domain ex:department ;\n                                rdfs:range ex:department ;\n                                ex:examples \"\u519b\u5de5\u4e00\u7ec4 belongs to parent department \u5927\u5ba2\u7279\u79cd\" ;\n                                ex:source_mapping \"\"\"\u539f\u59cb\u8868X\u90e8\u95e8\n\u67d0\u4e2a\u5b9e\u4f8b \u4e3adomain\n\u5176\u540c\u884c\u5de6\u4fa7\u5217\u7684\u5b9e\u4f8b \u4e3arange\"\"\" ;\n                                rdfs:comment \"\u67d0\u4e2a\u5b50\u90e8\u95e8\u7684\u4e0a\u7ea7\u90e8\u95e8\u662f\u54ea\u4e2a\" ;\n                                rdfs:label \"\u5f52\u5c5e\u4e0a\u7ea7\u90e8\u95e8\" .\n\n\n###  http://datahub/cost#belongs_to_product_catalogy\nex:belongs_to_product_catalogy rdf:type owl:ObjectProperty ,\n                                        owl:FunctionalProperty ;\n                               rdfs:domain ex:product ;\n                               rdfs:range ex:product_catelogy ;\n                               ex:source_mapping \"\"\"\\\"\u6240\u6709\u4ea7\u54c1\u4e3adomain\nrange\u5148\u4ece\u539f\u59cb\u88684 E\u5217\u5bf9\u5e94\u7684T\u5217\u6210\u672c\u4ea7\u54c1\u7ebf\u627e\u6700\u591a\u7684\u4e00\u4e2a\n\u4e3a\u7a7a\u7684\u8bdd\u53bb\u539f\u59cb\u8868X\u65e5\u62a5\u660e\u7ec6 I\u5217\u5bf9\u5e94\u7684U\u5217\u627e\u6700\u591a\u7684\u4e00\u4e2a\\\"\"\"\" ;\n                               rdfs:comment \"\u67d0\u4e2a\u4ea7\u54c1\u5728\u8ba1\u7b97\u6210\u672c\u65f6\uff0c\u5f52\u5c5e\u4e8e\u54ea\u4e2a\u4ea7\u54c1\u7c7b\u522b\" ;\n                               rdfs:label \"\u6240\u5c5e\u4ea7\u54c1\u6210\u672c\u7c7b\u522b\" .\n\n\n###  http://datahub/cost#belongs_to_product_line\nex:belongs_to_product_line rdf:type owl:ObjectProperty ,\n                                    owl:FunctionalProperty ;\n                           rdfs:domain ex:product ;\n                           rdfs:range ex:produce_line ;\n                           ex:source_mapping \"\u539f\u59cb\u8868X \u65e5\u62a5\u660e\u7ec6-\u65e5\u62a5\u660e\u7ec6 I\u5217\u4ea7\u54c1\u7c7b\u578b\u4e3adomain J\u5217\u4ea7\u54c1\u6761\u7ebf\u4e3arange\" ;\n                           rdfs:comment \"\u67d0\u4e2a\u4ea7\u54c1\u5c5e\u4e8e\u54ea\u4e2a\u4ea7\u54c1\u6761\u7ebf\" ;\n                           rdfs:label \"\u5f52\u5c5e\u4ea7\u54c1\u6761\u7ebf\" .\n\n\n###  http://datahub/cost#belongs_to_service_catalogy\nex:belongs_to_service_catalogy rdf:type owl:ObjectProperty ,\n                                        owl:FunctionalProperty ;\n                               rdfs:domain ex:service ;\n                               rdfs:range ex:service_catalogy ;\n                               ex:source_mapping \"\"\"\\\"\u539f\u59cb\u88686\n\u670d\u52a1\u7c7b\u76ee \u4e3arange\n\u540c\u884c\u7684\u670d\u52a1\u7533\u8bf7\u7f16\u53f7 \u4e3adomain\\\"\"\"\" ;\n                               rdfs:comment \"\u67d0\u4e2a\u670d\u52a1\u7533\u8bf7\u65f6\u7684\u670d\u52a1\u7c7b\u76ee\uff0c\u7528\u4e8e\u5bf9\u5916\u5305\u670d\u52a1\u5546\u8bf4\u660e\u7684\u4efb\u52a1\u5185\u5bb9\u5206\u7c7b\" ;\n                               rdfs:label \"\u6240\u5c5e\u670d\u52a1\u7c7b\u76ee\" .\n\n\n###  http://datahub/cost#contain_product\nex:contain_product rdf:type owl:ObjectProperty ,\n                            owl:FunctionalProperty ;\n                   rdfs:domain ex:order ;\n                   rdfs:range ex:product ;\n                   ex:examples \"S00540771 contain product WPS 365\u6559\u80b2\u9ad8\u7ea7\u7248\" ;\n                   ex:source_mapping \"\"\"\u539f\u59cb\u88684\n\u8ba2\u5355\u53f7 \u4e3adomain\n\u540c\u884c\u7684\u4ea7\u54c1\u540d\u79f0 \u4e3arange\"\"\" ;\n                   rdfs:comment \"\u67d0\u4e2a\u8ba2\u5355\u4e2d\u5305\u542b\u4ec0\u4e48\u4ea7\u54c1\uff0c\u5373\u5ba2\u6237\u60f3\u8981\u8d2d\u4e70\u4ec0\u4e48\u4ea7\u54c1\" ;\n                   rdfs:label \"\u5305\u542b\u4ea7\u54c1\" .\n\n\n###  http://datahub/cost#contain_projects\nex:contain_projects rdf:type owl:ObjectProperty ,\n                             owl:InverseFunctionalProperty ;\n                    rdfs:domain ex:customer ;\n                    rdfs:range ex:project ;\n                    ex:source_mapping \"\"\"\\\"\u539f\u59cb\u8868X PMS\nA\u5217\u9879\u76ee\u7f16\u53f7 \u4e3arange\n\u540c\u884c\u7684 G\u5217\u5ba2\u6237\u7f16\u53f7 \u4e3adomain\\\"\"\"\" ;\n                    rdfs:comment \"\u5ba2\u6237\u540d\u4e0b\u90fd\u5305\u542b\u54ea\u4e9b\u9879\u76ee\" ;\n                    rdfs:label \"\u5305\u542b\u9879\u76ee\" .\n\n\n###  http://datahub/cost#contractor_work_belongs_to_product\nex:contractor_work_belongs_to_product rdf:type owl:ObjectProperty ,\n                                               owl:FunctionalProperty ;\n                                      rdfs:domain ex:contractor_work ;\n                                      rdfs:range ex:product ;\n                                      ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5 A\u65e5\u62a5\u660e\u7ec6\u540d\u79f0\u4f5c\u4e3adomain\u3001Q\u4ea7\u54c1\u540d\u79f0\uff08\u9879\u76ee\u4ea7\u54c1\u5e93\uff09\u4e3arange\" ;\n                                      rdfs:comment \"\u5916\u5305\u5de5\u4f5c\u662f\u9488\u5bf9\u54ea\u4e2a\u4ea7\u54c1\u4ea7\u751f\u7684\" ;\n                                      rdfs:label \"\u5916\u5305\u5de5\u4f5c\u6d89\u53ca\u4ea7\u54c1\" .\n\n\n###  http://datahub/cost#contractor_work_belongs_to_task\nex:contractor_work_belongs_to_task rdf:type owl:ObjectProperty ,\n                                            owl:FunctionalProperty ;\n                                   rdfs:domain ex:contractor_work ;\n                                   rdfs:range ex:task ;\n                                   ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5 A\u65e5\u62a5\u660e\u7ec6\u540d\u79f0\u4f5c\u4e3adomain\u3001AO\u4efb\u52a1\u4e66\u7f16\u53f7 \u4e3arange\" ;\n                                   rdfs:comment \"\u5916\u5305\u5de5\u4f5c\u5c5e\u4e8e\u54ea\u4e2a\u5916\u5305\u4efb\u52a1\" ;\n                                   rdfs:label \"\u5916\u5305\u5de5\u4f5c\u5f52\u5c5e\u4efb\u52a1\" .\n\n\n###  http://datahub/cost#customer_belongs_to_department\nex:customer_belongs_to_department rdf:type owl:ObjectProperty ,\n                                           owl:FunctionalProperty ;\n                                  rdfs:domain ex:customer ;\n                                  rdfs:range ex:department ;\n                                  ex:source_mapping \"\"\"\\\"\u539f\u59cb\u8868X PMS\nP\u5217\u5ba2\u6237\u5f52\u5c5e\u90e8\u95e8\u4e3arange\n\u540c\u884c\u7684 G\u5217\u5ba2\u6237\u7f16\u53f7 \u4e3adomain\\\"\"\"\" ;\n                                  rdfs:comment \"\u5ba2\u6237\u7531\u516c\u53f8\u5185\u7684\u54ea\u4e2a\u90e8\u95e8\u8d1f\u8d23\uff0c\u6700\u7ec8\u5916\u5305\u670d\u52a1\u6210\u672c\u4e5f\u6309\u7167\u6b64\u90e8\u95e8\u8ba1\u7b97\u5f52\u5c5e\" ;\n                                  rdfs:label \"\u5ba2\u6237\u7531\u67d0\u4e2a\u90e8\u95e8\u8d1f\u8d23\" .\n\n\n###  http://datahub/cost#depend_on_level_2_corporate_budget\nex:depend_on_level_2_corporate_budget rdf:type owl:ObjectProperty ,\n                                               owl:FunctionalProperty ;\n                                      rdfs:domain ex:service ;\n                                      rdfs:range ex:corporate_budget ;\n                                      ex:examples \"PR-20250926-0005 depend on level 2 corporate budget 25T-TBG-Q4-PRO-V4.3\" ;\n                                      ex:source_mapping \"\"\"\u539f\u59cb\u88686 \n\u4e8c\u7ea7\u9884\u7b97ID \u4e3arange\n\u540c\u884c\u7684 \u670d\u52a1\u7533\u8bf7\u7f16\u53f7 \u4e3adomain\"\"\" ;\n                                      rdfs:comment \"\u67d0\u4e2a\u670d\u52a1\u7684\u8d39\u7528\u8ba1\u5212\u4f9d\u8d56\u54ea\u4e2a\u9884\u7b97\u7ea7\u522b\u4e3a\u201c\u4e8c\u7ea7\u201d\u7684\u516c\u53f8\u9884\u7b97\" ;\n                                      rdfs:label \"\u4f9d\u8d56\u516c\u53f8\u4e8c\u7ea7\u9884\u7b97\" .\n\n\n###  http://datahub/cost#depend_on_level_3_corporate_budget\nex:depend_on_level_3_corporate_budget rdf:type owl:ObjectProperty ,\n                                               owl:FunctionalProperty ;\n                                      rdfs:domain ex:service ;\n                                      rdfs:range ex:corporate_budget ;\n                                      ex:examples \"PR-20250926-0005 depend on level 3 corporate budget 25Q4-DKYX-V4.3\" ;\n                                      ex:source_mapping \"\"\"\u539f\u59cb\u88686 \n\u9884\u7b97\u6620\u5c04ID \u4e3arange\n\u540c\u884c\u7684 \u670d\u52a1\u7533\u8bf7\u7f16\u53f7 \u4e3adomain\"\"\" ;\n                                      rdfs:comment \"\u67d0\u4e2a\u670d\u52a1\u7533\u8bf7\u7684\u8d39\u7528\u8ba1\u5212\u4f9d\u8d56\u54ea\u4e2a\u9884\u7b97\u7ea7\u522b\u4e3a\u201c\u4e09\u7ea7\u201d\u7684\u516c\u53f8\u9884\u7b97\" ;\n                                      rdfs:label \"\u4f9d\u8d56\u516c\u53f8\u4e09\u7ea7\u9884\u7b97\" .\n\n\n###  http://datahub/cost#depend_on_opportunity\nex:depend_on_opportunity rdf:type owl:ObjectProperty ,\n                                  owl:FunctionalProperty ;\n                         rdfs:domain ex:project_budget ;\n                         rdfs:range ex:opportunity ;\n                         owl:propertyDisjointWith ex:depend_on_order ;\n                         ex:examples \"PBD\uff0320250100035 depend on opportunity PR-00167290\" ;\n                         ex:source_mapping \"\"\"\u539f\u59cb\u88684 \\\"\u8ba2\u5355\u53f7\u201d\u82e5\u6ca1\u6709\u503c\u4e14\u201c\u5546\u673a\u53f7\u201d\u6709\u503c\u60c5\u51b5\u4e0b\n\u53d6\u201c\u9879\u76ee\u9884\u7b97\u660e\u7ec6\u7f16\u53f7\u201d\u4e3adomain\n\u53d6\u540c\u884c\u201c\u5546\u673a\u53f7\u201d\u4e3arange\"\"\" ;\n                         rdfs:comment \"\u9879\u76ee\u7533\u8bf7\u8be5\u9884\u7b97\uff0c\u56e0\u4e3a\u5ba2\u6237\u5df2\u4ea7\u751f\u4e86\u5546\u673a\" ;\n                         rdfs:label \"\u9879\u76ee\u9884\u7b97\u4f9d\u8d56\u5546\u673a\" .\n\n\n###  http://datahub/cost#depend_on_order\nex:depend_on_order rdf:type owl:ObjectProperty ,\n                            owl:FunctionalProperty ;\n                   rdfs:domain ex:project_budget ;\n                   rdfs:range ex:order ;\n                   ex:examples \"PBD\uff0320250600001 depend on order S00292777\" ;\n                   ex:source_mapping \"\"\"\u539f\u59cb\u88684 \\\"\u8ba2\u5355\u53f7\u201d\u82e5\u6709\u503c\n\u53d6\u201c\u9879\u76ee\u9884\u7b97\u660e\u7ec6\u7f16\u53f7\u201d\u4e3adomain\n\u53d6\u540c\u884c\u201c\u8ba2\u5355\u53f7\u201d\u4e3arange\"\"\" ;\n                   rdfs:comment \"\u9879\u76ee\u7533\u8bf7\u8be5\u9884\u7b97\uff0c\u56e0\u4e3a\u5ba2\u6237\u5df2\u4ea7\u751f\u4e86\u5b9e\u9645\u8ba2\u5355\" ;\n                   rdfs:label \"\u9879\u76ee\u9884\u7b97\u4f9d\u8d56\u8ba2\u5355\" .\n\n\n###  http://datahub/cost#depend_on_project_budget\nex:depend_on_project_budget rdf:type owl:ObjectProperty ,\n                                     owl:FunctionalProperty ;\n                            rdfs:domain ex:service ;\n                            rdfs:range ex:project_budget ;\n                            ex:examples \"PR-20250926-0005 depend on project budget PBD\uff0320250100035\" ;\n                            ex:source_mapping \"\"\"\u539f\u59cb\u88684 \n\u9879\u76ee\u9884\u7b97\u660e\u7ec6\u7f16\u53f7 \u4e3arange\n\u540c\u884c\u7684 \u670d\u52a1\u7533\u8bf7\u7f16\u53f7 \u4e3adomain\"\"\" ;\n                            rdfs:comment \"\u67d0\u4e2a\u670d\u52a1\u7533\u8bf7\u7684\u8d39\u7528\u8ba1\u5212\u4f9d\u8d56\u54ea\u4e2a\u9879\u76ee\u9884\u7b97\" ;\n                            rdfs:label \"\u4f9d\u8d56\u9879\u76ee\u9884\u7b97\" .\n\n\n###  http://datahub/cost#employee_work_belongs_to_service_type\nex:employee_work_belongs_to_service_type rdf:type owl:ObjectProperty ,\n                                                  owl:FunctionalProperty ;\n                                         rdfs:domain ex:employee_work ;\n                                         rdfs:range ex:service_type ;\n                                         ex:source_mapping \"\"\"\\\"\u539f\u59cb\u8868X \u65e5\u62a5\u660e\u7ec6-\u65e5\u62a5\u660e\u7ec6\nX\u5217 \u670d\u52a1\u9879\u76ee \u4e3arange\nA\u5217\u7f16\u53f7 \u4e3adomain\n\u5176\u4e2d\u90e8\u5206\u670d\u52a1\u9879\u76ee\u8981\u505a\u8f6c\u5316\n\u79c1\u6709\u4e91\u5347\u7ea7-----\u4e13\u9879\u670d\u52a1-\u5347\u7ea7\n\u6807\u51c6\u57f9\u8bad\u670d\u52a1-----\u6807\u51c6\u57f9\u8bad\n\u8fdc\u7a0b\u6280\u672f\u652f\u6301------\u8fdc\u7a0b\u652f\u6301\u670d\u52a1\\\"\"\"\" ;\n                                         rdfs:comment \"\u6b63\u7f16\u5de5\u4f5c\u7684\u5185\u5bb9\u5c5e\u4e8e\u4ec0\u4e48\u670d\u52a1\u7c7b\u578b\" ;\n                                         rdfs:label \"\u6b63\u7f16\u5de5\u4f5c\u6240\u5c5e\u670d\u52a1\u7c7b\u578b\" .\n\n\n###  http://datahub/cost#generate_employee_work\nex:generate_employee_work rdf:type owl:ObjectProperty ,\n                                   owl:InverseFunctionalProperty ;\n                          rdfs:domain ex:project ;\n                          rdfs:range ex:employee_work ;\n                          ex:source_mapping \"\"\"\u539f\u59cb\u8868X M\u5217\u9879\u76ee\u7f16\u53f7\u4e3adomain\nA\u5217\u7f16\u53f7\u4e3arange\"\"\" ;\n                          rdfs:comment \"\u5f53\u67d0\u4e2a\u6b63\u7f16\u5458\u5de5\u5728\u67d0\u4e2a\u9879\u76ee\u4ea7\u751f\u5de5\u65f6\u6295\u5165\u65f6\uff0c\u5373\u8bb0\u5f55\u4e00\u6761\u6b63\u7f16\u5de5\u4f5c\uff0c\u5de5\u65f6\u4f1a\u6309\u7167\u516c\u5f0f\u8ba1\u7b97\u4e3a\u91d1\u989d\uff0c\u4f5c\u4e3a\u9879\u76ee\u6210\u672c\" ;\n                          rdfs:label \"\u9879\u76ee\u4ea7\u751f\u6b63\u7f16\u5de5\u4f5c\" .\n\n\n###  http://datahub/cost#generate_opportunity\nex:generate_opportunity rdf:type owl:ObjectProperty ,\n                                 owl:InverseFunctionalProperty ;\n                        rdfs:domain ex:customer ;\n                        rdfs:range ex:opportunity ;\n                        ex:source_mapping \"\"\"\\\"\u539f\u59cb\u88684 \n\u5546\u673a\u53f7 \u4e3arange\n\u540c\u884c\u7684 \u5ba2\u6237\u540d\u79f0 \u5339\u914d\u5230\u5bf9\u5e94\u7684\u5ba2\u6237ID \u4e3adomain\\\"\"\"\" ;\n                        rdfs:comment \"\u5ba2\u6237\u4f1a\u4ea7\u751f\u54ea\u4e2a\u5546\u673a\uff0c\u6709\u610f\u5411\u8d2d\u4e70\u6211\u4eec\u4ea7\u54c1\" ;\n                        rdfs:label \"\u5ba2\u6237\u4ea7\u751f\u5546\u673a\" .\n\n\n###  http://datahub/cost#generate_order\nex:generate_order rdf:type owl:ObjectProperty ,\n                           owl:InverseFunctionalProperty ;\n                  rdfs:domain ex:opportunity ;\n                  rdfs:range ex:order ;\n                  ex:source_mapping \"\"\"\u539f\u59cb\u88684 \n\u8ba2\u5355\u53f7 \u4e3arange\n\u540c\u884c\u7684 \u5ba2\u6237\u540d\u79f0 \u4e3adomain\"\"\" ;\n                  rdfs:comment \"\u5ba2\u6237\u5b9e\u9645\u9700\u8981\u8d2d\u4e70\u67d0\u4e2a\u4ea7\u54c1\u65f6\uff0c\u7531\u9500\u552e\u8d1f\u8d23\u4eba\u6839\u636e\u5546\u673a\uff0c\u5728\u516c\u53f8\u5185\u90e8\u4ea7\u751f\u8ba2\u5355\" ;\n                  rdfs:label \"\u5ba2\u6237\u4ea7\u751f\u8ba2\u5355\" .\n\n\n###  http://datahub/cost#generate_project_budget\nex:generate_project_budget rdf:type owl:ObjectProperty ,\n                                    owl:InverseFunctionalProperty ;\n                           rdfs:domain ex:project ;\n                           rdfs:range ex:project_budget ;\n                           ex:source_mapping \"\"\"\u539f\u59cb\u88684 \n\u9879\u76ee\u9884\u7b97\u660e\u7ec6\u7f16\u53f7 \u4e3arange\n\u540c\u884c\u7684 \u9879\u76ee\u540d\u79f0 \u5339\u914d\u5230\u7684\u9879\u76eeID \u4e3adomain\"\"\" ;\n                           rdfs:comment \"\u67d0\u4e2a\u9879\u76ee\u4e3a\u4e86\u540e\u7eed\u6f5c\u5728\u7684\u5916\u5305\u670d\u52a1\uff0c\u63d0\u524d\u7533\u8bf7\u7684\u9884\u7b97\" ;\n                           rdfs:label \"\u9879\u76ee\u4ea7\u751f\u9879\u76ee\u9884\u7b97\" .\n\n\n###  http://datahub/cost#generate_single-customer_service\nex:generate_single-customer_service rdf:type owl:ObjectProperty ,\n                                             owl:InverseFunctionalProperty ;\n                                    rdfs:domain ex:project ;\n                                    rdfs:range ex:service ;\n                                    ex:source_mapping \"\"\"\u670d\u52a1\u4e3a\u5355\u5ba2\u6237\u65f6\n\u539f\u59cb\u88684 \n\u670d\u52a1\u7533\u8bf7\u7f16\u53f7\u4e3arange\n\u540c\u884c\u7684 \u9879\u76ee\u540d\u79f0 \u5339\u914d\u5230\u7684\u9879\u76eeID \u4e3adomain\\\"\"\"\" ;\n                                    rdfs:comment \"\u67d0\u4e2a\u9879\u76ee\u9700\u8981\u57f9\u8bad\u3001\u5b9a\u5236\u7b49\u670d\u52a1\u65f6\uff0c\u4ea7\u751f\u7684\u5916\u5305\u670d\u52a1\u7533\u8bf7\uff0c\u53ef\u80fd\u662f\u5355\u5ba2\u6237\u9879\u76ee\u6574\u5305\uff0c\u4e5f\u53ef\u80fd\u662f\u5355\u5ba2\u6237\u4eba\u5458\u5916\u5305\" ;\n                                    rdfs:label \"\u9879\u76ee\u4ea7\u751f\u5355\u5ba2\u6237\u5916\u5305\u670d\u52a1\" .\n\n\n###  http://datahub/cost#generate_task\nex:generate_task rdf:type owl:ObjectProperty ,\n                          owl:InverseFunctionalProperty ;\n                 rdfs:domain ex:service ;\n                 rdfs:range ex:task ;\n                 ex:source_mapping \"\"\"\\\"\u539f\u59cb\u88683\u3001\u539f\u59cb\u88685\n\u4efb\u52a1\u4e66\u7f16\u53f7 \u4e3arange\n\u540c\u884c\u7684 \u670d\u52a1\u7533\u8bf7\u7f16\u53f7 \u4e3adomain\\\"\"\"\" ;\n                 rdfs:comment \"\u67d0\u4e2a\u670d\u52a1\u7533\u8bf7\u901a\u8fc7\u540e\uff0c\u57fa\u4e8e\u8fd9\u4e2a\u7533\u8bf7\u4ea7\u751f\u7684\u4efb\u52a1\" ;\n                 rdfs:label \"\u5916\u5305\u670d\u52a1\u4ea7\u751f\u4efb\u52a1\" .\n\n\n###  http://datahub/cost#multi-customer_service_belongs_to_department\nex:multi-customer_service_belongs_to_department rdf:type owl:ObjectProperty ,\n                                                         owl:FunctionalProperty ;\n                                                rdfs:domain ex:service ;\n                                                rdfs:range ex:department ;\n                                                ex:source_mapping \"\"\"\\\"\u670d\u52a1\u4e3a\u591a\u5ba2\u6237\u670d\u52a1\u65f6\n\u539f\u59cb\u88686 K\u5217\u9879\u76ee\u8d1f\u8d23\u4eba\u90e8\u95e8\\\"\"\"\" ;\n                                                rdfs:comment \"\u591a\u5ba2\u6237\u670d\u52a1\u4ea7\u751f\u7684\u8d39\u7528\u6210\u672c\u5f52\u5c5e\u5230\u516c\u53f8\u54ea\u4e2a\u90e8\u95e8\" ;\n                                                rdfs:label \"\u591a\u5ba2\u6237\u5916\u5305\u670d\u52a1\u6210\u672c\u5f52\u5c5e\u90e8\u95e8\" .\n\n\n###  http://datahub/cost#order_belongs_to_department\nex:order_belongs_to_department rdf:type owl:ObjectProperty ,\n                                        owl:FunctionalProperty ;\n                               rdfs:domain ex:order ;\n                               rdfs:range ex:department ;\n                               ex:examples \"S00540771 order belongs to department \u6559\u80b2\u9500\u552e\u534e\u4e1c\u7ec4\" ;\n                               ex:source_mapping \"\"\"\u539f\u59cb\u88684\n\u8ba2\u5355\u53f7 \u4e3adomain\n\u6839\u636e\u670d\u52a1\u7533\u8bf7\u7f16\u53f7\uff0c\u5728\u539f\u59cb\u88686\u5bfb\u627e\u8ba2\u5355/\u5546\u673a\u5f52\u5c5e\u90e8\u95e8 \u4e3arange\"\"\" ;\n                               rdfs:comment \"\u4e3b\u67d0\u4e2a\u8ba2\u5355\u7531\u516c\u53f8\u5185\u7684\u54ea\u4e2a\u90e8\u95e8\u8d1f\u8d23\uff0c\u901a\u5e38\u4e0e\u8ba2\u5355\u6240\u5c5e\u5ba2\u6237\u7684\u8d1f\u8d23\u90e8\u95e8\u76f8\u540c\" ;\n                               rdfs:label \"\u8ba2\u5355\u7531\u67d0\u4e2a\u90e8\u95e8\u8d1f\u8d23\" .\n\n\n###  http://datahub/cost#product_involved_in_employee_work\nex:product_involved_in_employee_work rdf:type owl:ObjectProperty ,\n                                              owl:FunctionalProperty ;\n                                     rdfs:domain ex:employee_work ;\n                                     rdfs:range ex:product ;\n                                     ex:source_mapping \"\"\"\u539f\u59cb\u8868X \u65e5\u62a5\u660e\u7ec6-\u65e5\u62a5\u660e\u7ec6\nI\u5217 \u4ea7\u54c1\u7c7b\u578b \u4e3arange\nA\u5217\u7f16\u53f7 \u4e3adomain\"\"\" ;\n                                     rdfs:comment \"\u6b63\u7f16\u5de5\u4f5c\u7684\u5185\u5bb9\u4e3b\u8981\u662f\u5bf9\u4ec0\u4e48\u4ea7\u54c1\u53d1\u751f\u7684\" ;\n                                     rdfs:label \"\u6b63\u7f16\u5de5\u4f5c\u6d89\u53ca\u4ea7\u54c1\" .\n\n\n###  http://datahub/cost#product_involved_in_service\nex:product_involved_in_service rdf:type owl:ObjectProperty ,\n                                        owl:FunctionalProperty ;\n                               rdfs:domain ex:service ;\n                               rdfs:range ex:product ;\n                               ex:source_mapping \"\u539f\u59cb\u88684 E\u5217\u4ea7\u54c1\u540d\u79f0\u4e3arange\u3001A\u5217\u670d\u52a1\u7533\u8bf7\u4e3adomain\" ;\n                               rdfs:comment \"\u5916\u5305\u670d\u52a1\u4e3b\u8981\u9488\u5bf9\u54ea\u4e2a\u4ea7\u54c1\uff0c\u9879\u76ee\u6574\u5305\u65f6\uff0c\u5bf9\u5e94\u7684\u4efb\u52a1\u5373\u9488\u5bf9\u6b64\u4ea7\u54c1\" ;\n                               rdfs:label \"\u5916\u5305\u670d\u52a1\u6d89\u53ca\u4ea7\u54c1\" .\n\n\n###  http://datahub/cost#project-based_task_belongs_to_product_catalogy\nex:project-based_task_belongs_to_product_catalogy rdf:type owl:ObjectProperty ,\n                                                           owl:FunctionalProperty ;\n                                                  rdfs:domain ex:task ;\n                                                  rdfs:range ex:product_catelogy ;\n                                                  ex:source_mapping \"\"\"\\\"\u539f\u59cb\u88683 \uff08\u8fd9\u4e2a\u8868\u91cc\u672c\u8eab\u90fd\u662f\u6574\u5305\u7684\u4efb\u52a1\uff09\n\u4efb\u52a1\u4e66\u7f16\u53f7 \u4e3adomain\n\u6839\u636e\u540c\u884c\u7684\u670d\u52a1\u7533\u8bf7\u7f16\u53f7\uff0c\u5728\u539f\u59cb\u88684\u627e\u5230\u5bf9\u5e94\u7684T\u5217\u201c\u6210\u672c\u4ea7\u54c1\u7ebf\u201d\u4e3arange\\\"\"\"\" ;\n                                                  rdfs:comment \"\u5f53\u4efb\u52a1\u5bf9\u5e94\u7684\u670d\u52a1\u4e3a\u9879\u76ee\u6574\u5305\u65f6\uff0c\u4efb\u52a1\u4ea7\u751f\u7684\u6210\u672c\u5f52\u5c5e\u5230\u54ea\u4e2a\u4ea7\u54c1\u7c7b\u522b\" ;\n                                                  rdfs:label \"\u6574\u5305\u4efb\u52a1\u8d39\u7528\u5f52\u5c5e\u4ea7\u54c1\u7c7b\u522b\" .\n\n\n###  http://datahub/cost#project-based_task_belongs_to_service_type\nex:project-based_task_belongs_to_service_type rdf:type owl:ObjectProperty ,\n                                                       owl:FunctionalProperty ;\n                                              rdfs:domain ex:task ;\n                                              rdfs:range ex:service_type ;\n                                              ex:source_mapping \"\"\"\\\"\u539f\u59cb\u88683 \u9879\u76ee\u4efb\u52a1\u4e66\nF\u5217\u4efb\u52a1\u4e66\u7f16\u53f7 \u4e3adomain\n\u5bf9\u5e94E\u5217\u670d\u52a1\u7533\u8bf7 \u5728\u539f\u59cb\u88684\u4e2d\u5bf9\u5e94K\u5217 \u670d\u52a1\u7c7b\u578b\uff08\u9884\u7b97\uff09 \u4e3arange\\\"\"\"\" ;\n                                              rdfs:comment \"\u67d0\u4e2a\u6574\u5305\u4efb\u52a1\u5f52\u5c5e\u4e8e\u6211\u4eec\u516c\u53f8\u5185\u90e8\u5b9a\u4e49\u7684\u54ea\u79cd\u670d\u52a1\u7c7b\u578b\" ;\n                                              rdfs:label \"\u6574\u5305\u4efb\u52a1\u5f52\u5c5e\u670d\u52a1\u7c7b\u578b\" .\n\n\n###  http://datahub/cost#project_belongs_to_department\nex:project_belongs_to_department rdf:type owl:ObjectProperty ,\n                                          owl:FunctionalProperty ;\n                                 rdfs:domain ex:project ;\n                                 rdfs:range ex:department ;\n                                 ex:source_mapping \"\"\"\\\"\u539f\u59cb\u8868X PMS\nAB\u5217 \u5f53\u524d\u8d1f\u8d23\u4eba\u6240\u5c5e\u56db\u7ea7\u90e8\u95e8 \u4e3arange\nA\u5217\u9879\u76ee\u7f16\u53f7 \u4e3adomain\\\"\"\"\" ;\n                                 rdfs:comment \"\u9879\u76ee\u7531\u516c\u53f8\u5185\u7684\u54ea\u4e2a\u90e8\u95e8\u8d1f\u8d23\uff0c\u901a\u5e38\u4e3a\u9879\u76ee\u8d1f\u8d23\u4eba\u6240\u5728\u7684\u90e8\u95e8\" ;\n                                 rdfs:label \"\u9879\u76ee\u7531\u67d0\u4e2a\u90e8\u95e8\u8d1f\u8d23\" .\n\n\n###  http://datahub/cost#project_generate_contractor_work\nex:project_generate_contractor_work rdf:type owl:ObjectProperty ,\n                                             owl:InverseFunctionalProperty ;\n                                    rdfs:domain ex:project ;\n                                    rdfs:range ex:contractor_work ;\n                                    ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5 AA\u4e3b\u9879\u76ee\u7f16\u53f7\u4f5c\u4e3adomain\u3001A\u65e5\u62a5\u660e\u7ec6\u540d\u79f0\u4f5c\u4e3arange\" ;\n                                    rdfs:comment \"\u5f53\u67d0\u4e2a\u5916\u5305\u5458\u5de5\u5728\u67d0\u4e2a\u9879\u76ee\u4ea7\u751f\u5de5\u65f6\u6295\u5165\u65f6\uff0c\u5373\u8bb0\u5f55\u4e00\u6761\u5916\u5305\u5de5\u4f5c\uff0c\u5916\u5305\u5de5\u4f5c\u7ecf\u9a8c\u6536\u540e\u7684\u6210\u672c\u53ef\u8ba1\u5165\u9879\u76ee\u6210\u672c\" ;\n                                    rdfs:label \"\u9879\u76ee\u4ea7\u751f\u5916\u5305\u5de5\u4f5c\" .\n\n\n###  http://datahub/cost#task_generate_contractor_work_acceptance\nex:task_generate_contractor_work_acceptance rdf:type owl:ObjectProperty ,\n                                                     owl:InverseFunctionalProperty ;\n                                            rdfs:domain ex:task ;\n                                            rdfs:range ex:contractor_work_acceptance ;\n                                            ex:source_mapping \"\u539f\u59cb\u886811 C\u5217\u4efb\u52a1\u4e66\u7f16\u53f7\u4e3adomain\u3001A\u5217\u4e3arange\" ;\n                                            rdfs:comment \"\u5bf9\u54ea\u4e2a\u5916\u5305\u4efb\u52a1\u8fdb\u884c\u4e86\u6708\u5ea6\u9a8c\u6536\" ;\n                                            rdfs:label \"\u5916\u5305\u4efb\u52a1\u53d1\u751f\u6708\u5ea6\u9a8c\u6536\" .\n\n\n#################################################################\n#    Data properties\n#################################################################\n\n###  http://datahub/cost#Task_Engineer_Total_Price\nex:Task_Engineer_Total_Price rdf:type owl:DatatypeProperty ,\n                                      owl:FunctionalProperty ;\n                             rdfs:domain ex:task ;\n                             rdfs:range xsd:decimal ;\n                             ex:source_mapping \"\u539f\u59cb\u88685 \u7b7e\u7ea6\u72b6\u6001 Z\u5217\u603b\u91d1\u989d\" ;\n                             rdfs:comment \"\u4ec5\u4eba\u5458\u5916\u5305\u7684\u4efb\u52a1\u6d89\u53ca\uff0c\u6307\u8fd9\u6b21\u4efb\u52a1\u9700\u8981\u5916\u5305\u5de5\u7a0b\u5e08\u6295\u5165\u7684\u9884\u4f30\u603b\u4ef7\uff08\u6309\u4eba\u5929\u8ba1\u7b97\uff09\" ;\n                             rdfs:label \"\u4efb\u52a1\u5de5\u7a0b\u5e08\u603b\u4ef7\" .\n\n\n###  http://datahub/cost#Task_Engineer_Total_Service_Hours\nex:Task_Engineer_Total_Service_Hours rdf:type owl:DatatypeProperty ,\n                                              owl:FunctionalProperty ;\n                                     rdfs:domain ex:task ;\n                                     rdfs:range xsd:integer ;\n                                     ex:source_mapping \"\u539f\u59cb\u88685 \u7b7e\u7ea6\u72b6\u6001 Y\u5217\u670d\u52a1\u603b\u4eba\u5929\" ;\n                                     rdfs:label \"\u4efb\u52a1\u5de5\u7a0b\u5e08\u670d\u52a1\u603b\u5de5\u65f6\" .\n\n\n###  http://datahub/cost#Task_Engineer_Unit_Price\nex:Task_Engineer_Unit_Price rdf:type owl:DatatypeProperty ,\n                                     owl:FunctionalProperty ;\n                            rdfs:domain ex:task ;\n                            rdfs:range xsd:decimal ;\n                            ex:source_mapping \"\u539f\u59cb\u88685 \u7b7e\u7ea6\u72b6\u6001 X\u5217\u5355\u4ef7\" ;\n                            rdfs:comment \"\u4ec5\u4eba\u5458\u5916\u5305\u7684\u4efb\u52a1\u6d89\u53ca\uff0c\u6307\u6d3e\u53d1\u7684\u5916\u5305\u5de5\u7a0b\u5e08\u5de5\u65f6\u5355\u4ef7\uff08\u6309\u4eba\u5929\u8ba1\u7b97\uff09\" ;\n                            rdfs:label \"\u4efb\u52a1\u5de5\u7a0b\u5e08\u5355\u4ef7\" .\n\n\n###  http://datahub/cost#approval_status\nex:approval_status rdf:type owl:DatatypeProperty ,\n                            owl:FunctionalProperty ;\n                   rdfs:domain ex:service ;\n                   rdfs:range xsd:string ;\n                   ex:examples \"\u5ba1\u6279\u901a\u8fc7\" ;\n                   ex:source_mapping \"\u539f\u59cb\u88686 \u5ba1\u6279\u72b6\u6001\" ;\n                   rdfs:comment \"\u670d\u52a1\u7533\u8bf7\u662f\u5426\u5df2\u7ecf\u5728\u516c\u53f8\u5185\u5ba1\u6279\u901a\u8fc7\" ;\n                   rdfs:label \"\u5ba1\u6279\u72b6\u6001\" ;\n                   owl:versionInfo 1124 .\n\n\n###  http://datahub/cost#contract_entity\nex:contract_entity rdf:type owl:DatatypeProperty ,\n                            owl:FunctionalProperty ;\n                   rdfs:domain ex:task ;\n                   rdfs:range xsd:string ;\n                   ex:examples \"\u5317\u4eac\u91d1\u5c71\u529e\u516c\u8f6f\u4ef6\u80a1\u4efd\u6709\u9650\u516c\u53f8\" ;\n                   ex:source_mapping \"\u539f\u59cb\u88683\u3001\u539f\u59cb\u88685 \u6211\u53f8\u7b7e\u7ea6\u4e3b\u4f53\" ;\n                   rdfs:comment \"\u4e0e\u670d\u52a1\u5546\u7b7e\u7ea6\u5408\u540c\u7684\u662f\u6211\u53f8\u7684\u54ea\u5bb6\u5206\u516c\u53f8\" ;\n                   rdfs:label \"\u7b7e\u7ea6\u4e3b\u4f53\" .\n\n\n###  http://datahub/cost#contractor_work_Date\nex:contractor_work_Date rdf:type owl:DatatypeProperty ,\n                                 owl:FunctionalProperty ;\n                        rdfs:domain ex:contractor_work ;\n                        rdfs:range xsd:date ;\n                        ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5\u660e\u7ec6 AK\u5217\u65e5\u62a5\u5f52\u5c5e\u65e5\u671f\" ;\n                        rdfs:comment \"\u5916\u5305\u5de5\u4f5c\u53d1\u751f\u7684\u65e5\u671f\" ;\n                        rdfs:label \"\u5916\u5305\u5de5\u4f5c\u53d1\u751f\u65f6\u95f4\" .\n\n\n###  http://datahub/cost#contractor_work_Description\nex:contractor_work_Description rdf:type owl:DatatypeProperty ,\n                                        owl:FunctionalProperty ;\n                               rdfs:domain ex:contractor_work ;\n                               rdfs:range xsd:string ;\n                               ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5\u660e\u7ec6 G\u5217\u5de5\u4f5c\u63cf\u8ff0\" ;\n                               rdfs:comment \"\u5916\u5305\u5de5\u4f5c\u7684\u5177\u4f53\u5185\u5bb9\" ;\n                               rdfs:label \"\u5916\u5305\u5de5\u4f5c\u63cf\u8ff0\" .\n\n\n###  http://datahub/cost#contractor_work_Engineer\nex:contractor_work_Engineer rdf:type owl:DatatypeProperty ,\n                                     owl:FunctionalProperty ;\n                            rdfs:domain ex:contractor_work ;\n                            rdfs:range xsd:string ;\n                            ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5\u660e\u7ec6 AM\u5217\u5de5\u7a0b\u5e08\u59d3\u540d\" ;\n                            rdfs:comment \"\u54ea\u4e2a\u5916\u5305\u5de5\u7a0b\u5e08\u6295\u5165\u4e86\u9879\u76ee\u5de5\u4f5c\" ;\n                            rdfs:label \"\u5916\u5305\u5de5\u4f5c\u5de5\u7a0b\u5e08\" .\n\n\n###  http://datahub/cost#contractor_work_Method\nex:contractor_work_Method rdf:type owl:DatatypeProperty ,\n                                   owl:FunctionalProperty ;\n                          rdfs:domain ex:contractor_work ;\n                          rdfs:range xsd:string ;\n                          ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5\u660e\u7ec6 U\u5217\u670d\u52a1\u65b9\u5f0f\" ;\n                          rdfs:comment \"\"\"\\\"\u5916\u5305\u5de5\u4f5c\u662f\u5426\u8981\u5230\u73b0\u573a\uff0c\u679a\u4e3e\u5305\u62ec\n-\u73b0\u573a\u6280\u672f\u652f\u6301\uff08\u4e09\u5929\u5185\uff09\n-\u73b0\u573a\u6280\u672f\u652f\u6301\uff08\u4e09\u5929\u4ee5\u4e0a\uff09\n-\u8fdc\u7a0b\u6280\u672f\u652f\u6301\n-\u9a7b\u573a\u670d\u52a1\\\"\"\"\" ;\n                          rdfs:label \"\u5916\u5305\u5de5\u4f5c\u65b9\u5f0f\" .\n\n\n###  http://datahub/cost#contractor_work_Type\nex:contractor_work_Type rdf:type owl:DatatypeProperty ,\n                                 owl:FunctionalProperty ;\n                        rdfs:domain ex:contractor_work ;\n                        rdfs:range xsd:string ;\n                        ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5\u660e\u7ec6 F\u5217\u5de5\u4f5c\u7c7b\u578b\" ;\n                        rdfs:comment \"\u7528\u4e8e\u5c06\u4e0d\u540c\u5916\u5305\u5de5\u4f5c\u5185\u5bb9\u5206\u7c7b\" ;\n                        rdfs:label \"\u5916\u5305\u5de5\u4f5c\u7c7b\u578b\" .\n\n\n###  http://datahub/cost#contractor_work_Vendor\nex:contractor_work_Vendor rdf:type owl:DatatypeProperty ,\n                                   owl:FunctionalProperty ;\n                          rdfs:domain ex:contractor_work ;\n                          rdfs:range xsd:string ;\n                          ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5\u660e\u7ec6 M\u5217\u6240\u5c5e\u90e8\u95e8\" ;\n                          rdfs:comment \"\u6295\u5165\u8be5\u5de5\u4f5c\u7684\u5916\u5305\u5de5\u7a0b\u5e08\u5f52\u5c5e\u54ea\u5bb6\u670d\u52a1\u5546\uff0c\u679a\u4e3e\u5305\u62ec\" ;\n                          rdfs:label \"\u5916\u5305\u5de5\u4f5c\u6240\u5c5e\u670d\u52a1\u5546\" .\n\n\n###  http://datahub/cost#contractor_work__Project_Phase\nex:contractor_work__Project_Phase rdf:type owl:DatatypeProperty ,\n                                           owl:FunctionalProperty ;\n                                  rdfs:domain ex:contractor_work ;\n                                  rdfs:range xsd:string ;\n                                  ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5\u660e\u7ec6 AE\u5217\u9879\u76ee\u5168\u5468\u671f\u9636\u6bb5\" ;\n                                  rdfs:comment \"\"\"\\\"\u5de5\u4f5c\u53d1\u751f\u65f6\u9879\u76ee\u6240\u5904\u7684\u9636\u6bb5\uff0c\u6309\u7167\u9879\u76ee\u7684\u53d1\u5c55\u987a\u5e8f\uff0c\u679a\u4e3e\u5982\u4e0b\n-\u9700\u6c42\u4ea4\u6d41\n-\u65b9\u6848\u786e\u8ba4\n-\u63a8\u52a8\u7b7e\u7ea6\n-\u6295\u4ea7\u9636\u6bb5\n-\u63a8\u5e7f\u9a8c\u6536\n-\u8fd0\u7ef4\u9636\u6bb5\\\"\"\"\" ;\n                                  rdfs:label \"\u5916\u5305\u5de5\u4f5c\u6240\u5c5e\u9879\u76ee\u9636\u6bb5\" .\n\n\n###  http://datahub/cost#contractor_work_acceptance_content\nex:contractor_work_acceptance_content rdf:type owl:DatatypeProperty ,\n                                               owl:FunctionalProperty ;\n                                      rdfs:domain ex:contractor_work_acceptance ;\n                                      rdfs:range xsd:string ;\n                                      ex:source_mapping \"\u539f\u59cb\u886811 B\u5217 \u4e3b\u9898\" ;\n                                      rdfs:comment \"\u8bf4\u660e\u9a8c\u6536\u7684\u4e3b\u8981\u5185\u5bb9\" ;\n                                      rdfs:label \"\u5916\u5305\u4efb\u52a1\u6708\u5ea6\u9a8c\u6536\u5185\u5bb9\" .\n\n\n###  http://datahub/cost#contractor_work_acceptance_id\nex:contractor_work_acceptance_id rdf:type owl:DatatypeProperty ,\n                                          owl:FunctionalProperty ;\n                                 rdfs:domain ex:contractor_work_acceptance ;\n                                 rdfs:range xsd:string ;\n                                 ex:source_mapping \"\u539f\u59cb\u886811 A\u5217 \u5de5\u7a0b\u5e08\u4efb\u52a1\u9a8c\u6536\u5355\u7f16\u7801\" ;\n                                 rdfs:comment \"\u4e00\u6b21\u4efb\u52a1\u9a8c\u6536\u7684ID\u6807\u8bc6\" ;\n                                 rdfs:label \"\u5916\u5305\u4efb\u52a1\u6708\u5ea6\u9a8c\u6536ID\" .\n\n\n###  http://datahub/cost#contractor_work_acceptance_month\nex:contractor_work_acceptance_month rdf:type owl:DatatypeProperty ,\n                                             owl:FunctionalProperty ;\n                                    rdfs:domain ex:contractor_work_acceptance ;\n                                    rdfs:range xsd:string ;\n                                    ex:source_mapping \"\u539f\u59cb\u886811 B\u5217 E \u53d6\u6708\u4efd\u503c\" ;\n                                    rdfs:comment \"\u5bf92025\u5e74\u54ea\u4e2a\u6708\u7684\u4efb\u52a1\u8fdb\u884c\u9a8c\u6536\" ;\n                                    rdfs:label \"\u9a8c\u6536\u6708\u4efd\" .\n\n\n###  http://datahub/cost#contractor_work_acceptance_quality\nex:contractor_work_acceptance_quality rdf:type owl:DatatypeProperty ,\n                                               owl:FunctionalProperty ;\n                                      rdfs:domain ex:contractor_work_acceptance ;\n                                      rdfs:range xsd:decimal ;\n                                      ex:source_mapping \"\u539f\u59cb\u886811 R\u5217 \u8d28\u91cf\u7cfb\u6570\" ;\n                                      rdfs:comment \"\u5bf9\u4efb\u52a1\u5b8c\u6210\u8d28\u91cf\u7684\u8bc4\u4ef7\uff0c\u4e3a1\u65f6\u4ee3\u8868100%\u5b8c\u6210\u30010.9\u65f6\u4ee3\u886890%\u5b8c\u6210\uff0c\u4ee5\u6b64\u7c7b\u63a8\" ;\n                                      rdfs:label \"\u8d28\u91cf\u7cfb\u6570\" .\n\n\n###  http://datahub/cost#contractor_work_acceptance_total_cost\nex:contractor_work_acceptance_total_cost rdf:type owl:DatatypeProperty ,\n                                                  owl:FunctionalProperty ;\n                                         rdfs:domain ex:contractor_work_acceptance ;\n                                         rdfs:range xsd:decimal ;\n                                         ex:source_mapping \"\u539f\u59cb\u886811 H\u5217 \u9a8c\u6536\u603b\u91d1\u989d\" ;\n                                         rdfs:comment \"\u9a8c\u6536\u6838\u7b97\u540e\u7684\u603b\u91d1\u989d\uff0c\u5373\u5b9e\u9645\u5728\u672c\u6708\u53d1\u751f\u7684\u6210\u672c\uff0c\u5305\u542b\u5dee\u65c5\u8d39\" ;\n                                         rdfs:label \"\u9a8c\u6536\u603b\u91d1\u989d\" .\n\n\n###  http://datahub/cost#contractor_work_acceptance_travel_cost\nex:contractor_work_acceptance_travel_cost rdf:type owl:DatatypeProperty ,\n                                                   owl:FunctionalProperty ;\n                                          rdfs:domain ex:contractor_work_acceptance ;\n                                          rdfs:range xsd:decimal ;\n                                          ex:source_mapping \"\u539f\u59cb\u886811 I\u5217 \u9a8c\u6536\u5dee\u65c5\u8d39\" ;\n                                          rdfs:comment \"\u9a8c\u6536\u6838\u7b97\u540e\u7684\u6210\u672c\u8d39\u7528\u4e2d\uff0c\u5dee\u65c5\u8d39\u662f\u591a\u5c11\" ;\n                                          rdfs:label \"\u9a8c\u6536\u5dee\u65c5\u8d39\" .\n\n\n###  http://datahub/cost#contractor_work_cost\nex:contractor_work_cost rdf:type owl:DatatypeProperty ,\n                                 owl:FunctionalProperty ;\n                        rdfs:domain ex:contractor_work ;\n                        rdfs:range xsd:decimal ;\n                        ex:source_mapping \"\u627e\u5230\u5de5\u4f5c\u5bf9\u5e94\u4efb\u52a1\u7684\u5de5\u7a0b\u5e08\u5355\u4ef7\uff0c\u4e58\u5916\u5305\u5de5\u4f5c\u9a8c\u6536\u5de5\u65f6\" ;\n                        rdfs:comment \"\u5916\u5305\u5de5\u4f5c\u7ecf\u8fc7\u6211\u4eec\u9a8c\u6536\u540e\uff0c\u7ecf\u8fc7\u6821\u51c6\u540e\u7684\u5b9e\u9645\u6210\u672c\uff0c\u5373\u9700\u8981\u652f\u4ed8\u7ed9\u8be5\u5de5\u7a0b\u5e08\u5f52\u5c5e\u670d\u52a1\u5546\u7684\u5b9e\u9645\u8d39\u7528\" ;\n                        rdfs:label \"\u5916\u5305\u5de5\u4f5c\u6210\u672c\u8d39\u7528\" .\n\n\n###  http://datahub/cost#contractor_work_hours_Ratio\nex:contractor_work_hours_Ratio rdf:type owl:DatatypeProperty ,\n                                        owl:FunctionalProperty ;\n                               rdfs:domain ex:contractor_work ;\n                               rdfs:range xsd:decimal ;\n                               ex:source_mapping \"\"\"\\\"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5\u660e\u7ec6\n\u53d6AO\u5217\u4efb\u52a1\u4e66\u7f16\u53f7\u76f8\u540c\u3001\u6708\u5ea6\u5f52\u5c5e\u76f8\u540c\u7684\u6240\u6709\u5de5\u4f5c\uff0c\u52a0\u5408\u5de5\u65f6\uff0c\u8ba1\u7b97\u5f53\u524d\u5de5\u4f5c\u5de5\u65f6\u7684\u5360\u6bd4\\\"\"\"\" ;\n                               rdfs:comment \"\u8be5\u5de5\u4f5c\u4e0a\u62a5\u7684\u5de5\u65f6\uff0c\u5728\u672c\u6708\u3001\u540c\u4efb\u52a1\u4ea7\u751f\u7684\u603b\u5de5\u65f6\u4e2d\u5360\u6bd4\u591a\u5c11\" ;\n                               rdfs:label \"\u5916\u5305\u5de5\u65f6\u5360\u6bd4\" .\n\n\n###  http://datahub/cost#contractor_work_hours_acceptance\nex:contractor_work_hours_acceptance rdf:type owl:DatatypeProperty ,\n                                             owl:FunctionalProperty ;\n                                    rdfs:domain ex:contractor_work ;\n                                    rdfs:range xsd:decimal ;\n                                    ex:source_mapping \"\"\"\\\"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5\u660e\u7ec6\n\u53d6\u4efb\u52a1\u4e66\u7f16\u53f7\n\u5728\u539f\u59cb\u8868X \u9a8c\u6536\u5355\u4e2d\uff0c\u627e\u5230\u5bf9\u5e94\u6708\u5ea6\u7684\u9a8c\u6536\u4eba\u5929\u6570\uff0c\u4e58\u4ee5\u5916\u5305\u5de5\u65f6\u5360\u6bd4\\\"\"\"\" ;\n                                    rdfs:comment \"\u5916\u5305\u5de5\u4f5c\u7ecf\u8fc7\u6211\u4eec\u9a8c\u6536\u540e\uff0c\u7ecf\u8fc7\u6821\u51c6\uff0c\u53ef\u8ba1\u7b97\u6210\u672c\u7684\u5b9e\u9645\u5de5\u65f6\uff0c\u5355\u4f4d\u4e3a\u4eba\u5929\" ;\n                                    rdfs:label \"\u5916\u5305\u5de5\u4f5c\u9a8c\u6536\u5de5\u65f6\" .\n\n\n###  http://datahub/cost#contractor_work_hours_reported\nex:contractor_work_hours_reported rdf:type owl:DatatypeProperty ,\n                                           owl:FunctionalProperty ;\n                                  rdfs:domain ex:contractor_work ;\n                                  rdfs:range xsd:decimal ;\n                                  ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5\u660e\u7ec6 D\u5217\u5de5\u65f6\uff08h\uff09\" ;\n                                  rdfs:comment \"\u7531\u5916\u5305\u5de5\u7a0b\u5e08\u81ea\u884c\u4e0a\u62a5\u7684\u5916\u5305\u5de5\u4f5c\u6295\u5165\u5de5\u4f5c\u65f6\u957f\uff0c \u4ee5\u5c0f\u65f6\u4e3a\u5355\u4f4d\" ;\n                                  rdfs:label \"\u5916\u5305\u5de5\u7a0b\u5e08\u4e0a\u62a5\u5de5\u65f6\" .\n\n\n###  http://datahub/cost#contractor_work_id\nex:contractor_work_id rdf:type owl:DatatypeProperty ,\n                               owl:FunctionalProperty ;\n                      rdfs:domain ex:contractor_work ;\n                      rdfs:range xsd:string ;\n                      ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5\u660e\u7ec6 A\u5217\u65e5\u62a5\u660e\u7ec6\u540d\u79f0\" ;\n                      rdfs:comment \"\u5916\u5305\u5de5\u4f5c\u7684\u6807\u8bc6ID\" ;\n                      rdfs:label \"\u5916\u5305\u5de5\u4f5cID\" .\n\n\n###  http://datahub/cost#corporate_budget_id\nex:corporate_budget_id rdf:type owl:DatatypeProperty ,\n                                owl:FunctionalProperty ;\n                       rdfs:domain ex:corporate_budget ;\n                       rdfs:range xsd:string ;\n                       ex:examples \"25T-TBG-Q4-PRO-V4.3\" ;\n                       ex:source_mapping \"\u539f\u59cb\u88686  \u201c\u9884\u7b97\u6620\u5c04ID\u201d\u548c\\\"\u4e8c\u7ea7\u9884\u7b97ID\u201d\" ;\n                       rdfs:comment \"\u516c\u53f8\u9884\u7b97\u7684\u6807\u8bc6id\uff0c\u5176\u4e2d25TBG-SD-OPR-23\u4e3a\u54c1\u724c\u5e02\u573a\u90e8\u9884\u7b97\u300125CLD-SD-BPO-01\u4e3a\u4ea7\u7814\u9884\u7b97\" ;\n                       rdfs:label \"\u516c\u53f8\u9884\u7b97ID\" .\n\n\n###  http://datahub/cost#corporate_budget_item_description\nex:corporate_budget_item_description rdf:type owl:DatatypeProperty ,\n                                              owl:FunctionalProperty ;\n                                     rdfs:domain ex:corporate_budget ;\n                                     rdfs:range xsd:string ;\n                                     ex:examples \"\u9a7b\u573a\u670d\u52a1\" ;\n                                     ex:source_mapping \"\u539f\u59cb\u88686 \u9884\u7b97\u4e8b\u9879\u63cf\u8ff0\" ;\n                                     rdfs:comment \"\u9884\u7b97\u4e3b\u8981\u7528\u4e8e\u54ea\u4e9b\u670d\u52a1\u4e8b\u9879\uff0c\u4ec5\u4e8c\u7ea7\u9884\u7b97\u5305\u542b\u6b64\u5b57\u6bb5\" ;\n                                     rdfs:label \"\u9884\u7b97\u4e8b\u9879\u63cf\u8ff0\" .\n\n\n###  http://datahub/cost#corporate_budget_level\nex:corporate_budget_level rdf:type owl:DatatypeProperty ,\n                                   owl:FunctionalProperty ;\n                          rdfs:domain ex:corporate_budget ;\n                          rdfs:range xsd:string ;\n                          ex:examples \"\u4e8c\u7ea7\u9884\u7b97\" ;\n                          ex:source_mapping \"\u539f\u59cb\u88686  \u201c\u9884\u7b97\u6620\u5c04ID\u201d\u4e3a\u4e09\u7ea7\u9884\u7b97\uff0c\\\"\u4e8c\u7ea7\u9884\u7b97ID\u201d\u4e3a\u4e8c\u7ea7\u9884\u7b97\" ;\n                          rdfs:label \"\u9884\u7b97\u7684\u7ea7\u522b\uff0c\u5f53\u524d\u5171\u6709\u4e24\u7ea7\uff1a\u4e8c\u7ea7\u548c\u4e09\u7ea7\uff1b\u4e00\u4e2a\u4e8c\u7ea7\u9884\u7b97\u4e0b\u5305\u542b\u591a\u4e2a\u4e09\u7ea7\u9884\u7b97\" ,\n                                     \"\u9884\u7b97\u7ea7\u522b\" .\n\n\n###  http://datahub/cost#corporate_budget_subject\nex:corporate_budget_subject rdf:type owl:DatatypeProperty ,\n                                     owl:FunctionalProperty ;\n                            rdfs:domain ex:corporate_budget ;\n                            rdfs:range xsd:string ;\n                            ex:examples \"\u9a7b\u573a\u670d\u52a1\" ;\n                            ex:source_mapping \"\u539f\u59cb\u88686 \u9884\u7b97\u79d1\u76ee\" ;\n                            rdfs:comment \"\u9884\u7b97\u7684\u4f5c\u7528\uff0c\u4ec5\u4e8c\u7ea7\u9884\u7b97\u5305\u542b\u6b64\u5b57\u6bb5\" ;\n                            rdfs:label \"\u9884\u7b97\u79d1\u76ee\" .\n\n\n###  http://datahub/cost#customer_field\nex:customer_field rdf:type owl:DatatypeProperty ,\n                           owl:FunctionalProperty ;\n                  rdfs:domain ex:customer ;\n                  rdfs:range xsd:string ;\n                  ex:source_mapping \"\u539f\u59cb\u8868PMS X\u5217\u5ba2\u6237\u884c\u4e1a\u7c7b\u578b\uff0c\u4efb\u53d6\u4e00\u884c\u975e\u7a7a\u767d\u5373\u53ef\" ;\n                  rdfs:comment \"\u5ba2\u6237\u6240\u5728\u7684\u5177\u4f53\u884c\u4e1a\uff0c\u662f\u6bd4\u8f83\u7ec6\u81f4\u7684\u5206\u7c7b\" ;\n                  rdfs:label \"\u6240\u5c5e\u884c\u4e1a\" .\n\n\n###  http://datahub/cost#customer_fieldtype\nex:customer_fieldtype rdf:type owl:DatatypeProperty ,\n                               owl:FunctionalProperty ;\n                      rdfs:domain ex:customer ;\n                      rdfs:range xsd:string ;\n                      ex:examples \"\u56fd\u4f01\u884c\u4e1a\" ;\n                      ex:source_mapping \"\u539f\u59cb\u8868PMS  Y\u5217\u884c\u4e1a\u63a8\u5e7f\u7c7b\uff0c\u4efb\u53d6\u4e00\u884c\u5373\u53ef\" ;\n                      rdfs:comment \"\u5ba2\u6237\u6240\u5728\u7684\u884c\u4e1a\u7c7b\u578b\uff0c\u662f\u8f83\u4e3a\u5bbd\u6cdb\u7684\u5206\u7c7b\uff0c\u4e3b\u8981\u5206\u4e3a\u515a\u653f\u519b\u3001\u56fd\u4f01\u3001\u6559\u80b2\u3001\u91d1\u878d\u3001\u6c11\u4f01\u3001\u533b\u7597\" ;\n                      rdfs:label \"\u6240\u5c5e\u884c\u4e1a\u7c7b\u578b\" .\n\n\n###  http://datahub/cost#customer_id\nex:customer_id rdf:type owl:DatatypeProperty ,\n                        owl:FunctionalProperty ;\n               rdfs:domain ex:customer ;\n               rdfs:range xsd:string ;\n               ex:source_mapping \"\u539f\u59cb\u8868PMS  G\u5217\u5ba2\u6237\u7f16\u53f7\" ;\n               rdfs:comment \"\u5ba2\u6237\u7684\u6807\u8bc6ID\" ;\n               rdfs:label \"\u5ba2\u6237ID\" .\n\n\n###  http://datahub/cost#customer_name\nex:customer_name rdf:type owl:DatatypeProperty ,\n                          owl:FunctionalProperty ;\n                 rdfs:domain ex:customer ;\n                 rdfs:range xsd:string ;\n                 ex:examples \"\u5317\u4eac\u4e2d\u6838\u534e\u8f89\u79d1\u6280\u53d1\u5c55\u6709\u9650\u516c\u53f8\" ;\n                 ex:source_mapping \"\u539f\u59cb\u8868PMS  D\u5217\u5ba2\u6237\u5168\u7a0b\uff08CRM\uff09\uff0c\u4efb\u53d6\u4e00\u884c\u5373\u53ef\" ;\n                 rdfs:comment \"\u5ba2\u6237\u7684\u5b98\u65b9\u540d\u79f0\" ;\n                 rdfs:label \"\u5ba2\u6237\u540d\u79f0\" .\n\n\n###  http://datahub/cost#customer_sale\nex:customer_sale rdf:type owl:DatatypeProperty ,\n                          owl:FunctionalProperty ;\n                 rdfs:domain ex:customer ;\n                 rdfs:range xsd:string ;\n                 ex:examples \"\u7f57\u5e7d\u5170\" ;\n                 ex:source_mapping \"\u539f\u59cb\u8868PMS AG\u5217\u5ba2\u6237\u6240\u6709\u4eba\" ;\n                 rdfs:comment \"\u8d1f\u8d23\u8be5\u5ba2\u6237\u7684\u9500\u552e\" ;\n                 rdfs:label \"\u9500\u552e\u6240\u6709\u4eba\" .\n\n\n###  http://datahub/cost#customer_type\nex:customer_type rdf:type owl:DatatypeProperty ,\n                          owl:FunctionalProperty ;\n                 rdfs:domain ex:customer ;\n                 rdfs:range xsd:string ;\n                 ex:source_mapping \"\u539f\u59cb\u8868PMS  F\u5217\u5ba2\u6237\u7c7b\u578b\uff0c\u4efb\u53d6\u4e00\u884c\u5373\u53ef\" ;\n                 rdfs:comment \"\u7528\u4e8e\u533a\u5206\u5ba2\u6237\u7684\u5c5e\u6027\uff0c\u5982\u662f\u4f01\u4e1a\u8fd8\u662f\u515a\u653f\u673a\u5173\" ;\n                 rdfs:label \"\u5ba2\u6237\u7c7b\u578b\" .\n\n\n###  http://datahub/cost#delivery_manager\nex:delivery_manager rdf:type owl:DatatypeProperty ,\n                             owl:FunctionalProperty ;\n                    rdfs:domain ex:service ;\n                    rdfs:range xsd:string ;\n                    ex:examples \"\u5468\u4e911\" ;\n                    ex:source_mapping \"\u539f\u59cb\u88686 \u4ea4\u4ed8\u7ecf\u7406\" ;\n                    rdfs:comment \"\u8d1f\u8d23\u4e3a\u6b64\u6b21\u670d\u52a1\u8054\u7cfb\u5916\u90e8\u670d\u52a1\u5546\u3001\u5ba1\u6838\u670d\u52a1\u5408\u89c4\u6027\u7684\u8d1f\u8d23\u4eba\" ;\n                    rdfs:label \"\u4ea4\u4ed8\u7ecf\u7406\" .\n\n\n###  http://datahub/cost#delivery_method\nex:delivery_method rdf:type owl:DatatypeProperty ,\n                            owl:FunctionalProperty ;\n                   rdfs:domain ex:service ;\n                   rdfs:range xsd:string ;\n                   ex:examples \"\u8fdc\u7a0b\" ;\n                   ex:source_mapping \"\u539f\u59cb\u88686 \u4ea4\u4ed8\u65b9\u5f0f\" ;\n                   rdfs:comment \"\u9700\u8981\u73b0\u573a\u652f\u6301\u8fd8\u662f\u8fdc\u7a0b\u652f\u6301\" ;\n                   rdfs:label \"\u4ea4\u4ed8\u65b9\u5f0f\" .\n\n\n###  http://datahub/cost#dept_id\nex:dept_id rdf:type owl:DatatypeProperty ,\n                    owl:FunctionalProperty ;\n           rdfs:domain ex:department ;\n           rdfs:range xsd:string ;\n           ex:source_mapping \"\u81ea\u751f\u6210\" ;\n           rdfs:comment \"\u90e8\u95e8\u7684\u6807\u8bc6id\uff1b\" ;\n           rdfs:label \"\u90e8\u95e8ID\" .\n\n\n###  http://datahub/cost#dept_level\nex:dept_level rdf:type owl:DatatypeProperty ,\n                       owl:FunctionalProperty ;\n              rdfs:domain ex:department ;\n              rdfs:range xsd:string ;\n              ex:examples \"\u56db\u7ea7\" ;\n              ex:source_mapping \"\u539f\u59cb\u8868X \u90e8\u95e8 \u7b2c\u4e00\u884c\" ;\n              rdfs:comment \"\u90e8\u95e8\u7684\u7ea7\u522b\uff0c\u4ece\u4e00\u7ea7\u5f00\u59cb\uff0c\u53ef\u80fd\u662f\u591a\u7ea7\uff0c\u5c42\u7ea7\u4e0d\u9650\" ;\n              rdfs:label \"\u90e8\u95e8\u7ea7\u522b\" .\n\n\n###  http://datahub/cost#dept_name\nex:dept_name rdf:type owl:DatatypeProperty ;\n             rdfs:domain ex:department ;\n             rdfs:range xsd:string ;\n             ex:examples \"\u5927\u5ba2\u7279\u79cd\" ;\n             ex:source_mapping \"\u539f\u59cb\u8868X \u90e8\u95e8 \u7b2c\u4e00\u884c\u9664\u5916\" ;\n             rdfs:comment \"\u516c\u53f8\u5185\u90e8\u95e8\u7684\u540d\u79f0\uff0c\u53ef\u4ee5\u7528XX/YY/MM\u8868\u793a\uff0c\u542b\u4e49\u4e3a\u6700\u540e\u4e00\u7ea7\u90e8\u95e8\uff0c\u4f46\u540c\u65f6\u5c55\u793a\u5176\u4e0a\u7ea7\u90e8\u95e8\" ;\n             rdfs:label \"\u90e8\u95e8\u540d\u79f0\" .\n\n\n###  http://datahub/cost#employee_work_editor\nex:employee_work_editor rdf:type owl:DatatypeProperty ,\n                                 owl:FunctionalProperty ;\n                        rdfs:domain ex:employee_work ;\n                        rdfs:range xsd:string ;\n                        ex:source_mapping \"\u539f\u59cb\u8868X\u65e5\u62a5\u660e\u7ec6-\u65e5\u62a5\u660e\u7ec6 B\u5217\u65e5\u62a5\u586b\u5199\u4eba\" ;\n                        rdfs:comment \"\u54ea\u4e2a\u6b63\u7f16\u5458\u5de5\u6295\u5165\u4e86\u9879\u76ee\u5de5\u4f5c\" ;\n                        rdfs:label \"\u6b63\u7f16\u5de5\u4f5c\u6240\u5c5e\u4eba\" .\n\n\n###  http://datahub/cost#employee_work_hours\nex:employee_work_hours rdf:type owl:DatatypeProperty ,\n                                owl:FunctionalProperty ;\n                       rdfs:domain ex:employee_work ;\n                       rdfs:range xsd:decimal ;\n                       ex:source_mapping \"\u539f\u59cb\u8868X\u65e5\u62a5\u660e\u7ec6-\u65e5\u62a5\u660e\u7ec6 D\u5217\u5de5\u4f5c\u91cf\uff08\u5c0f\u65f6\uff09\" ;\n                       rdfs:comment \"\u6b63\u7f16\u5de5\u4f5c\u7684\u5b9e\u9645\u5de5\u65f6\uff0c\u4ee5\u5c0f\u65f6\u4e3a\u5355\u4f4d\" ;\n                       rdfs:label \"\u6b63\u7f16\u5de5\u4f5c\u91cf\" .\n\n\n###  http://datahub/cost#employee_work_id\nex:employee_work_id rdf:type owl:DatatypeProperty ,\n                             owl:FunctionalProperty ;\n                    rdfs:domain ex:employee_work ;\n                    rdfs:range xsd:string ;\n                    ex:source_mapping \"\u539f\u59cb\u8868X\u65e5\u62a5\u660e\u7ec6-\u65e5\u62a5\u660e\u7ec6 A\u5217\u7f16\u53f7\" ;\n                    rdfs:comment \"\u6b63\u7f16\u5de5\u4f5c\u7684\u6807\u8bc6ID\" ;\n                    rdfs:label \"\u6b63\u7f16\u5de5\u4f5cID\" .\n\n\n###  http://datahub/cost#employee_work_method\nex:employee_work_method rdf:type owl:DatatypeProperty ,\n                                 owl:FunctionalProperty ;\n                        rdfs:domain ex:employee_work ;\n                        rdfs:range xsd:string ;\n                        ex:source_mapping \"\u539f\u59cb\u8868X\u65e5\u62a5\u660e\u7ec6-\u65e5\u62a5\u660e\u7ec6 K\u5217\u5de5\u4f5c\u65b9\u5f0f\" ;\n                        rdfs:comment \"\"\"\\\"\u6b63\u7f16\u5de5\u4f5c\u662f\u5426\u8981\u5230\u73b0\u573a\uff0c\u679a\u4e3e\u5305\u62ec\n-\u529e\u516c\u5730\n-\u51fa\u5dee\n-\u5c45\u5bb6\u529e\u516c\n-\u5e02\u5185\u5916\u51fa\\\"\"\"\" ;\n                        rdfs:label \"\u6b63\u7f16\u5de5\u4f5c\u65b9\u5f0f\" .\n\n\n###  http://datahub/cost#employee_work_stage\nex:employee_work_stage rdf:type owl:DatatypeProperty ,\n                                owl:FunctionalProperty ;\n                       rdfs:domain ex:employee_work ;\n                       rdfs:range xsd:string ;\n                       ex:source_mapping \"\u539f\u59cb\u8868X\u65e5\u62a5\u660e\u7ec6-\u65e5\u62a5\u660e\u7ec6 R\u5217\u9879\u76ee\u5168\u5468\u671f\u9636\u6bb5\" ;\n                       rdfs:comment \"\"\"\\\"\u5de5\u4f5c\u53d1\u751f\u65f6\u9879\u76ee\u6240\u5904\u7684\u9636\u6bb5\uff0c\u6309\u7167\u9879\u76ee\u7684\u53d1\u5c55\u987a\u5e8f\uff0c\u679a\u4e3e\u5982\u4e0b\n-\u9700\u6c42\u4ea4\u6d41\n-\u65b9\u6848\u786e\u8ba4\n-\u63a8\u52a8\u7b7e\u7ea6\n-\u6295\u4ea7\u9636\u6bb5\n-\u63a8\u5e7f\u9a8c\u6536\n-\u8fd0\u7ef4\u9636\u6bb5\\\"\"\"\" ;\n                       rdfs:label \"\u6b63\u7f16\u5de5\u4f5c\u6240\u5c5e\u9879\u76ee\u9636\u6bb5\" .\n\n\n###  http://datahub/cost#employee_work_time\nex:employee_work_time rdf:type owl:DatatypeProperty ,\n                               owl:FunctionalProperty ;\n                      rdfs:domain ex:employee_work ;\n                      rdfs:range xsd:date ;\n                      ex:source_mapping \"\u539f\u59cb\u8868X\u65e5\u62a5\u660e\u7ec6-\u65e5\u62a5\u660e\u7ec6 C\u5217\u65e5\u62a5\u65e5\u671f\" ;\n                      rdfs:comment \"\u6b63\u7f16\u5de5\u4f5c\u53d1\u751f\u7684\u65e5\u671f\" ;\n                      rdfs:label \"\u6b63\u7f16\u5de5\u4f5c\u53d1\u751f\u65f6\u95f4\" .\n\n\n###  http://datahub/cost#employee_work_type\nex:employee_work_type rdf:type owl:DatatypeProperty ,\n                               owl:FunctionalProperty ;\n                      rdfs:domain ex:employee_work ;\n                      rdfs:range xsd:string ;\n                      ex:source_mapping \"\u539f\u59cb\u8868X\u65e5\u62a5\u660e\u7ec6-\u65e5\u62a5\u660e\u7ec6 K\u5217\u5de5\u4f5c\u65b9\u5f0f\" ;\n                      rdfs:comment \"\u7528\u4e8e\u5c06\u4e0d\u540c\u6b63\u7f16\u5de5\u4f5c\u5185\u5bb9\u5206\u7c7b\" ;\n                      rdfs:label \"\u6b63\u7f16\u5de5\u4f5c\u7c7b\u578b\" .\n\n\n###  http://datahub/cost#estimated_end_time\nex:estimated_end_time rdf:type owl:DatatypeProperty ,\n                               owl:FunctionalProperty ;\n                      rdfs:domain ex:service ;\n                      rdfs:range xsd:date ;\n                      ex:examples \"2025-10-24\" ;\n                      ex:source_mapping \"\u539f\u59cb\u88686 \u9884\u4f30\u7ed3\u675f\u65f6\u95f4\" ;\n                      rdfs:comment \"\u670d\u52a1\u9884\u8ba1\u7ed3\u675f\u7684\u65f6\u95f4\" ;\n                      rdfs:label \"\u9884\u4f30\u7ed3\u675f\u65f6\u95f4\" .\n\n\n###  http://datahub/cost#estimated_start_time\nex:estimated_start_time rdf:type owl:DatatypeProperty ,\n                                 owl:FunctionalProperty ;\n                        rdfs:domain ex:service ;\n                        rdfs:range xsd:date ;\n                        ex:examples \"2025-09-08\" ;\n                        ex:source_mapping \"\u539f\u59cb\u88686 \u9884\u4f30\u5f00\u59cb\u65f6\u95f4\" ;\n                        rdfs:comment \"\u670d\u52a1\u9884\u8ba1\u5f00\u59cb\u7684\u65f6\u95f4\" ;\n                        rdfs:label \"\u9884\u4f30\u5f00\u59cb\u65f6\u95f4\" .\n\n\n###  http://datahub/cost#is_standard_price\nex:is_standard_price rdf:type owl:DatatypeProperty ,\n                              owl:FunctionalProperty ;\n                     rdfs:domain ex:service ;\n                     rdfs:range xsd:string ;\n                     ex:source_mapping \"\u539f\u59cb\u88686 \u662f\u5426\u6807\u51c6\u4ef7\u683c\" ;\n                     rdfs:comment \"\u670d\u52a1\u662f\u5426\u4e3a\u5df2\u5b9a\u4e49\u597d\u7684\u6807\u51c6\u670d\u52a1\uff0c\u5e76\u91c7\u7528\u6807\u51c6\u62a5\u4ef7\uff0c\u8fd8\u662f\u9700\u8981\u53e6\u5916\u8bc4\u4f30\" ;\n                     rdfs:label \"\u662f\u5426\u6807\u51c6\u4ef7\u683c\" .\n\n\n###  http://datahub/cost#maintenance_period\nex:maintenance_period rdf:type owl:DatatypeProperty ,\n                               owl:FunctionalProperty ;\n                      rdfs:domain ex:service ;\n                      rdfs:range xsd:integer ;\n                      ex:examples \"12\" ;\n                      ex:source_mapping \"\u539f\u59cb\u88686 \u7ef4\u4fdd\u671f\" ;\n                      rdfs:comment \"\u670d\u52a1\u7ed3\u675f\u540e\uff0c\u670d\u52a1\u5546\u8fd8\u9700\u8981\u7ee7\u7eed\u63d0\u4f9b\u7ef4\u4fdd\u7684\u6708\u6570\" ;\n                      rdfs:label \"\u7ef4\u4fdd\u671f\" .\n\n\n###  http://datahub/cost#opportunity_details\nex:opportunity_details rdf:type owl:DatatypeProperty ,\n                                owl:FunctionalProperty ;\n                       rdfs:domain ex:opportunity ;\n                       rdfs:range xsd:string ;\n                       ex:examples \"\u534e\u8f89\u534f\u4f5c\u9879\u76ee_WPS 365\u4e13\u4e1a\u529e\u516c\u9ad8\u7ea7\u5e73\u53f0V7\" ;\n                       ex:source_mapping \"\u539f\u59cb\u88684 \u5546\u673a\u660e\u7ec6\" ;\n                       rdfs:comment \"\u5546\u673a\u7684\u8be6\u7ec6\u5185\u5bb9\" ;\n                       rdfs:label \"\u5546\u673a\u660e\u7ec6\" .\n\n\n###  http://datahub/cost#opportunity_id\nex:opportunity_id rdf:type owl:DatatypeProperty ,\n                           owl:FunctionalProperty ;\n                  rdfs:domain ex:opportunity ;\n                  rdfs:range xsd:string ;\n                  ex:examples \"PR-00167290\" ;\n                  ex:source_mapping \"\u539f\u59cb\u88684 \u5546\u673a\u53f7\" ;\n                  rdfs:comment \"\u5546\u673a\u7684\u6807\u8bc6id\" ;\n                  rdfs:label \"\u5546\u673aID\" .\n\n\n###  http://datahub/cost#order_id\nex:order_id rdf:type owl:DatatypeProperty ,\n                     owl:FunctionalProperty ;\n            rdfs:domain ex:order ;\n            rdfs:range xsd:string ;\n            ex:examples \"S00540771\" ;\n            ex:source_mapping \"\u539f\u59cb\u88684 \u8ba2\u5355\u53f7\" ;\n            rdfs:comment \"\u8ba2\u5355\u7684\u6807\u8bc6id\uff1b\" ;\n            rdfs:label \"\u8ba2\u5355ID\" .\n\n\n###  http://datahub/cost#person_in_charge_from_company\nex:person_in_charge_from_company rdf:type owl:DatatypeProperty ,\n                                          owl:FunctionalProperty ;\n                                 rdfs:domain ex:service ;\n                                 rdfs:range xsd:string ;\n                                 ex:source_mapping \"\"\"\\\"\u670d\u52a1\u4e3a\u201c\u516c\u53f8\u627f\u62c5\u65f6\u201d\n\u539f\u59cb\u88686 \u670d\u52a1\u7533\u8bf7\nJ\u5217 \u9879\u76ee\u8d1f\u8d23\u4eba\n\\\"\"\"\" ;\n                                 rdfs:comment \"\u670d\u52a1\u8d39\u7528\u7531\u516c\u53f8\u627f\u62c5\u65f6\uff0c\u516c\u53f8\u5185\u7684\u8d1f\u8d23\u4eba\u662f\u8c01\" ;\n                                 rdfs:label \"\u516c\u53f8\u627f\u62c5\u8d1f\u8d23\u4eba\" .\n\n\n###  http://datahub/cost#pj_feature\nex:pj_feature rdf:type owl:DatatypeProperty ;\n              rdfs:domain ex:project ;\n              rdfs:range xsd:string ;\n              ex:source_mapping \"\u539f\u59cb\u8868PMS R\u5217\u9879\u76ee\u7279\u5f81\" ;\n              rdfs:comment \"\u8bf4\u660e\u9879\u76ee\u5207\u5165\u70b9\uff0c\u4e3b\u8981\u4e3a\u89e3\u51b3\u5ba2\u6237\u4ec0\u4e48\u95ee\u9898\uff1b\u4e00\u4e2a\u9879\u76ee\u53ef\u80fd\u6709\u591a\u4e2a\u7279\u5f81\" ;\n              rdfs:label \"\u9879\u76ee\u7279\u5f81\" .\n\n\n###  http://datahub/cost#pj_leader\nex:pj_leader rdf:type owl:DatatypeProperty ,\n                      owl:FunctionalProperty ;\n             rdfs:domain ex:project ;\n             rdfs:range xsd:string ;\n             ex:examples \"\u6743\u5e7f\u653f\" ;\n             ex:source_mapping \"\u539f\u59cb\u8868PMS \u5f53\u524d\u8d1f\u8d23\u4eba\" ;\n             rdfs:comment \"\u9879\u76ee\u5f53\u524d\u9636\u6bb5\u7684\u4e3b\u8981\u8d1f\u8d23\u4eba\u3001\u6c47\u62a5\u4eba\" ;\n             rdfs:label \"\u9879\u76ee\u8d1f\u8d23\u4eba\" .\n\n\n###  http://datahub/cost#pj_level\nex:pj_level rdf:type owl:DatatypeProperty ,\n                     owl:FunctionalProperty ;\n            rdfs:domain ex:project ;\n            rdfs:range xsd:string ;\n            ex:source_mapping \"\u539f\u59cb\u8868PMS G\u5217\u9879\u76ee\u7c7b\u578b\" ;\n            rdfs:comment \"\u9879\u76ee\u7684\u91cd\u8981\u7a0b\u5ea6\" ;\n            rdfs:label \"\u9879\u76ee\u7ea7\u522b\" .\n\n\n###  http://datahub/cost#pj_manager\nex:pj_manager rdf:type owl:DatatypeProperty ,\n                       owl:FunctionalProperty ;\n              rdfs:domain ex:project ;\n              rdfs:range xsd:string ;\n              ex:source_mapping \"\u539f\u59cb\u8868PMS G\u5217\u9879\u76ee\u7c7b\u578b\" ;\n              rdfs:comment \"\u8d1f\u8d23\u9879\u76ee\u4ea4\u4ed8\u3001\u63a8\u5e7f\u7684\u8d1f\u8d23\u4eba\" ;\n              rdfs:label \"\u9879\u76ee\u7ecf\u7406\" .\n\n\n###  http://datahub/cost#pj_presale\nex:pj_presale rdf:type owl:DatatypeProperty ,\n                       owl:FunctionalProperty ;\n              rdfs:domain ex:project ;\n              rdfs:range xsd:string ;\n              ex:source_mapping \"\u539f\u59cb\u8868PMS \u552e\u524d\u7ecf\u7406\" ;\n              rdfs:comment \"\u8d1f\u8d23\u9879\u76ee\u552e\u524d\u6c9f\u901a\u3001\u65b9\u6848\u8bbe\u8ba1\u7684\u8d1f\u8d23\u4eba\" ;\n              rdfs:label \"\u552e\u524d\u7ecf\u7406\" .\n\n\n###  http://datahub/cost#pj_sign\nex:pj_sign rdf:type owl:DatatypeProperty ,\n                    owl:FunctionalProperty ;\n           rdfs:domain ex:project ;\n           rdfs:range xsd:string ;\n           ex:source_mapping \"\u539f\u59cb\u8868PMS AM\u5217\u662f\u5426\u7b7e\u5355\" ;\n           rdfs:comment \"\"\"\\\"\u9879\u76ee\u662f\u5426\u5df2\u7ecf\u7b7e\u5355\uff0c\u53ef\u80fd\u5305\u62ec\n-\u662f\uff1a\u5df2\u7ecf\u548c\u5ba2\u6237\u6b63\u5f0f\u7b7e\u5355\n-\u5426\uff1a\u8fd8\u6ca1\u6709\u6b63\u5f0f\u7b7e\u5355\n-\u8d60\u9001\uff1a\u514d\u8d39\u8d60\u9001\u7ed9\u5ba2\u6237\u4f7f\u7528\uff0c\u65e0\u9700\u7b7e\u5355\\\"\"\"\" ;\n           rdfs:label \"\u7b7e\u7ea6\u72b6\u6001\" .\n\n\n###  http://datahub/cost#pj_starttime\nex:pj_starttime rdf:type owl:DatatypeProperty ,\n                         owl:FunctionalProperty ;\n                rdfs:domain ex:project ;\n                rdfs:range xsd:date ;\n                ex:source_mapping \"\u539f\u59cb\u8868PMS O\u5217\u7acb\u9879\u65e5\u671f\" ;\n                rdfs:comment \"\u9879\u76ee\u6b63\u5f0f\u7acb\u9879\u7684\u65f6\u95f4\" ;\n                rdfs:label \"\u7acb\u9879\u65e5\u671f\" .\n\n\n###  http://datahub/cost#pj_tag\nex:pj_tag rdf:type owl:DatatypeProperty ,\n                   owl:FunctionalProperty ;\n          rdfs:domain ex:project ;\n          rdfs:range xsd:string ;\n          ex:source_mapping \"\"\"\\\"\u539f\u59cb\u8868PMS S\u5217\u81ea\u5b9a\u4e49\u6807\u7b7e\n\\\"\"\"\" ;\n          rdfs:comment \"\u4ece\u9879\u76ee\u7ba1\u7406\u89d2\u5ea6\u6253\u7684\u6807\u7b7e\uff0c\u4e3b\u8981\u53ef\u7528\u6765\u533a\u5206\u662f\u4e3aS15\u91cd\u70b9\u5173\u6ce8\u9879\u76ee\" ;\n          rdfs:label \"\u9879\u76ee\u6807\u7b7e\" .\n\n\n###  http://datahub/cost#pj_trace\nex:pj_trace rdf:type owl:DatatypeProperty ,\n                     owl:FunctionalProperty ;\n            rdfs:domain ex:project ;\n            rdfs:range xsd:string ;\n            ex:source_mapping \"\u539f\u59cb\u8868PMS  K\u5217\u9879\u76ee\u5168\u5468\u671f\u9636\u6bb5\" ;\n            rdfs:comment \"\u9879\u76ee\u5f53\u524d\u7684\u63a8\u8fdb\u9636\u6bb5\" ;\n            rdfs:label \"\u9879\u76ee\u9636\u6bb5\" .\n\n\n###  http://datahub/cost#pj_type\nex:pj_type rdf:type owl:DatatypeProperty ,\n                    owl:FunctionalProperty ;\n           rdfs:domain ex:project ;\n           rdfs:range xsd:string ;\n           ex:source_mapping \"\u539f\u59cb\u8868PMS G\u5217\u9879\u76ee\u7c7b\u578b\" ;\n           rdfs:comment \"\u7528\u6765\u533a\u5206\u9879\u76ee\u662f\u516c\u7f51\u3001\u79c1\u7f51\u8fd8\u662f\u751f\u6001\u4f19\u4f34\u9879\u76ee\" ;\n           rdfs:label \"\u9879\u76ee\u7c7b\u578b\" .\n\n\n###  http://datahub/cost#produce_line_name\nex:produce_line_name rdf:type owl:DatatypeProperty ,\n                              owl:FunctionalProperty ;\n                     rdfs:domain ex:produce_line ;\n                     rdfs:range xsd:string ;\n                     ex:source_mapping \"\u539f\u59cb\u8868X \u65e5\u62a5\u660e\u7ec6-\u65e5\u62a5\u660e\u7ec6 \u4ea7\u54c1\u6761\u7ebf\" ;\n                     rdfs:comment \"\u4ea7\u54c1\u6761\u7ebf\u7684\u540d\u79f0\" ;\n                     rdfs:label \"\u4ea7\u54c1\u6761\u7ebf\u540d\u79f0\" .\n\n\n###  http://datahub/cost#product_category_id\nex:product_category_id rdf:type owl:DatatypeProperty ,\n                                owl:FunctionalProperty ;\n                       rdfs:domain ex:product_catelogy ;\n                       rdfs:range xsd:string ;\n                       ex:source_mapping \"\u81ea\u751f\u6210\" ;\n                       rdfs:comment \"\u4ea7\u54c1\u7c7b\u522b\u7684\u6807\u8bc6id\uff1b\u6211\u4eec\u552e\u5356\u7684\u8f6f\u4ef6\u4ea7\u54c1\u5206\u7c7b\" ;\n                       rdfs:label \"\u4ea7\u54c1\u7c7b\u522bID\" .\n\n\n###  http://datahub/cost#product_category_name\nex:product_category_name rdf:type owl:DatatypeProperty ,\n                                  owl:FunctionalProperty ;\n                         rdfs:domain ex:product_catelogy ;\n                         rdfs:range xsd:string ;\n                         ex:examples \"\u516c\u6709\u4e91\" ;\n                         ex:source_mapping \"\u539f\u59cb\u88684 \u6210\u672c\u4ea7\u54c1\u7ebf\" ;\n                         rdfs:comment \"\u4ea7\u54c1\u7c7b\u522b\u7684\u540d\u79f0\" ;\n                         rdfs:label \"\u4ea7\u54c1\u7c7b\u522b\u540d\u79f0\" .\n\n\n###  http://datahub/cost#product_id\nex:product_id rdf:type owl:DatatypeProperty ,\n                       owl:FunctionalProperty ;\n              rdfs:domain ex:product ;\n              rdfs:range xsd:string ;\n              ex:source_mapping \"\u81ea\u751f\u6210\" ;\n              rdfs:comment \"\u4ea7\u54c1\u7684\u6807\u8bc6id\uff0c\u5373\u6211\u4eec\u5411\u5ba2\u6237\u552e\u5356\u7684\u8f6f\u4ef6\u4ea7\u54c1\" ;\n              rdfs:label \"\u4ea7\u54c1ID\" .\n\n\n###  http://datahub/cost#product_name\nex:product_name rdf:type owl:DatatypeProperty ,\n                         owl:FunctionalProperty ;\n                rdfs:domain ex:product ;\n                rdfs:range xsd:string ;\n                ex:examples \"WPS 365\u6559\u80b2\u9ad8\u7ea7\u7248\" ;\n                ex:source_mapping \"\u539f\u59cb\u88684 \u4ea7\u54c1\u540d\u79f0\" ;\n                rdfs:comment \"\u7ea6\u5b9a\u597d\u7684\u4ea7\u54c1\u540d\u79f0\" ;\n                rdfs:label \"\u4ea7\u54c1\u540d\u79f0\" .\n\n\n###  http://datahub/cost#project_budget_amount\nex:project_budget_amount rdf:type owl:DatatypeProperty ,\n                                  owl:FunctionalProperty ;\n                         rdfs:domain ex:project_budget ;\n                         rdfs:range xsd:decimal ;\n                         ex:examples \"272950\" ;\n                         ex:source_mapping \"\u539f\u59cb\u88684 \u9884\u7b97\u91d1\u989d\" ;\n                         rdfs:comment \"\u9884\u7b97\u4e2d\u5305\u542b\u7684\u603b\u91d1\u989d\" ;\n                         rdfs:label \"\u9884\u7b97\u91d1\u989d\" .\n\n\n###  http://datahub/cost#project_budget_dependency_type\nex:project_budget_dependency_type rdf:type owl:DatatypeProperty ,\n                                           owl:FunctionalProperty ;\n                                  rdfs:domain ex:project_budget ;\n                                  rdfs:range xsd:string ;\n                                  ex:examples \"\u5173\u8054\u5546\u673a\" ;\n                                  ex:source_mapping \"\u539f\u59cb\u88684 \\\"\u8ba2\u5355\u53f7\u82e5\u6709\u503c\uff0c\u5219\u4e3a\u201c\u5173\u8054\u8ba2\u5355\u201d\uff0c\u5426\u5219\u4e3a\u201c\u5173\u8054\u5546\u673a\u201d\" ;\n                                  rdfs:comment \"\u4f9d\u8d56\u8ba2\u5355\u8fd8\u662f\u5546\u673a\" ;\n                                  rdfs:label \"\u9884\u7b97\u4f9d\u8d56\u7c7b\u578b\" .\n\n\n###  http://datahub/cost#project_budget_id\nex:project_budget_id rdf:type owl:DatatypeProperty ,\n                              owl:FunctionalProperty ;\n                     rdfs:domain ex:project_budget ;\n                     rdfs:range xsd:string ;\n                     ex:examples \"PBD\uff0320250100035\" ;\n                     ex:source_mapping \"\u539f\u59cb\u88684 \u9879\u76ee\u9884\u7b97\u660e\u7ec6\u7f16\u53f7\" ;\n                     rdfs:comment \"\u9879\u76ee\u9884\u7b97\u7684\u6807\u8bc6id\uff1b\" ;\n                     rdfs:label \"\u9879\u76ee\u9884\u7b97ID\" .\n\n\n###  http://datahub/cost#project_id\nex:project_id rdf:type owl:DatatypeProperty ,\n                       owl:FunctionalProperty ;\n              rdfs:domain ex:project ;\n              rdfs:range xsd:string ;\n              ex:examples \"PJ-25010034\" ;\n              ex:source_mapping \"\u539f\u59cb\u8868PMS A\u5217\u9879\u76ee\u7f16\u53f7\" ;\n              rdfs:comment \"\u9879\u76ee\u7684\u6807\u8bc6ID\" ;\n              rdfs:label \"\u9879\u76eeID\" .\n\n\n###  http://datahub/cost#project_name\nex:project_name rdf:type owl:DatatypeProperty ;\n                rdfs:domain ex:project ;\n                rdfs:range xsd:string ;\n                ex:examples \"2025\u4e2d\u6838\u534e\u8f89\u91d1\u5c71\u534f\u4f5c\u9879\u76ee\" ;\n                ex:source_mapping \"\u539f\u59cb\u8868PMS B\u5217\u9879\u76ee\u540d\u79f0\" ;\n                rdfs:comment \"\u9879\u76ee\u7684\u5b98\u65b9\u540d\u79f0\" ;\n                rdfs:label \"\u9879\u76ee\u540d\u79f0\" .\n\n\n###  http://datahub/cost#project_remaining_occupiable_amount\nex:project_remaining_occupiable_amount rdf:type owl:DatatypeProperty ,\n                                                owl:FunctionalProperty ;\n                                       rdfs:domain ex:project_budget ;\n                                       rdfs:range xsd:decimal ;\n                                       ex:examples \"85550\" ;\n                                       ex:source_mapping \"\u9884\u7b97\u91d1\u989d\u51cf\u53bb\u9884\u7b97\u76f8\u5173\u7684\u670d\u52a1\u9884\u4f30\u8d39\u7528\" ;\n                                       rdfs:comment \"\u5373\u5269\u4f59\u53ef\u88ab\u522b\u7684\u670d\u52a1\u7533\u8bf7\u7684\u91d1\u989d\uff0c\u7b97\u6cd5\u4e3a\u9884\u7b97\u91d1\u989d\u51cf\u53bb\u9884\u7b97\u76f8\u5173\u7684\u670d\u52a1\u9884\u4f30\u8d39\u7528\" ;\n                                       rdfs:label \"\u5269\u4f59\u53ef\u5360\u7528\u91d1\u989d\" .\n\n\n###  http://datahub/cost#project_remaining_usable_amount\nex:project_remaining_usable_amount rdf:type owl:DatatypeProperty ,\n                                            owl:FunctionalProperty ;\n                                   rdfs:domain ex:project_budget ;\n                                   rdfs:range xsd:decimal ;\n                                   ex:examples \"85550\" ;\n                                   ex:source_mapping \"\u9884\u7b97\u91d1\u989d\u51cf\u53bb\u9884\u7b97\u76f8\u5173\u7684\u4efb\u52a1\u91d1\u989d\" ;\n                                   rdfs:comment \"\u5373\u9884\u7b97\u4e2d\u6263\u9664\u5df2\u7ecf\u5b9e\u9645\u82b1\u6389\u7684\u91d1\u989d\uff0c\u7b97\u6cd5\u4e3a\u9884\u7b97\u91d1\u989d\u51cf\u53bb\u9884\u7b97\u76f8\u5173\u7684\u670d\u52a1\u76f8\u5173\u7684\u4efb\u52a1\u91d1\u989d\" ;\n                                   rdfs:label \"\u5269\u4f59\u53ef\u4f7f\u7528\u91d1\u989d\" .\n\n\n###  http://datahub/cost#service_address\nex:service_address rdf:type owl:DatatypeProperty ,\n                            owl:FunctionalProperty ;\n                   rdfs:domain ex:service ;\n                   rdfs:range xsd:string ;\n                   ex:examples \"\u5317\u4eac\u5e02\u6d77\u6dc0\u533a\u79d1\u539f\u5927\u53a6B\u5ea7\" ;\n                   ex:source_mapping \"\u539f\u59cb\u88686 \u8be6\u7ec6\u5730\u5740\" ;\n                   rdfs:comment \"\u670d\u52a1\u7684\u9879\u76ee\u6240\u5728\u5730\" ;\n                   rdfs:label \"\u670d\u52a1\u8be6\u7ec6\u5730\u5740\" .\n\n\n###  http://datahub/cost#service_category_id\nex:service_category_id rdf:type owl:DatatypeProperty ,\n                                owl:FunctionalProperty ;\n                       rdfs:domain ex:service_catalogy ;\n                       rdfs:range xsd:string ;\n                       ex:source_mapping \"\u81ea\u751f\u6210\" ;\n                       rdfs:comment \"\u670d\u52a1\u7c7b\u76ee\u7684\u6807\u8bc6id\uff1b\" ;\n                       rdfs:label \"\u670d\u52a1\u7c7b\u76eeID\" .\n\n\n###  http://datahub/cost#service_category_name\nex:service_category_name rdf:type owl:DatatypeProperty ,\n                                  owl:FunctionalProperty ;\n                         rdfs:domain ex:service_catalogy ;\n                         rdfs:range xsd:string ;\n                         ex:examples \"\u79c1\u6709\u4e91\u4ea7\u54c1\u5b9a\u5236\u5f00\u53d1\" ;\n                         ex:source_mapping \"\u539f\u59cb\u88686 \u670d\u52a1\u7c7b\u76ee\" ;\n                         rdfs:comment \"\u670d\u52a1\u7c7b\u76ee\u7684\u540d\u79f0\uff0c\u5bf9\u670d\u52a1\u5185\u5bb9\u8fdb\u884c\u5206\u7c7b\uff0c\u5411\u5916\u90e8\u670d\u52a1\u5546\u58f0\u660e\" ;\n                         rdfs:label \"\u670d\u52a1\u7c7b\u76ee\u540d\u79f0\" .\n\n\n###  http://datahub/cost#service_city\nex:service_city rdf:type owl:DatatypeProperty ,\n                         owl:FunctionalProperty ;\n                rdfs:domain ex:service ;\n                rdfs:range xsd:string ;\n                ex:examples \"\u5317\u4eac\u5e02\" ;\n                ex:source_mapping \"\u539f\u59cb\u88686 \u57ce\u5e02\" ;\n                rdfs:comment \"\u670d\u52a1\u7684\u9879\u76ee\u6240\u5728\u57ce\u5e02\" ;\n                rdfs:label \"\u670d\u52a1\u6240\u5728\u57ce\u5e02\" .\n\n\n###  http://datahub/cost#service_content\nex:service_content rdf:type owl:DatatypeProperty ,\n                            owl:FunctionalProperty ;\n                   rdfs:domain ex:service ;\n                   rdfs:range xsd:string ;\n                   ex:examples \"\"\"1.\u8d1f\u8d23\u53cc\u56e0\u5b50\u8ba4\u8bc1\u65b9\u5f0f\u7684\u5b9a\u5f00\u3001\u6d4b\u8bd5\u3001\u90e8\u7f72\u548c\u8fd0\u7ef4\u5de5\u4f5c\uff1b\n2.\u8ba4\u8bc1\u65b9\u5f0f\u5305\u62ec\u8d26\u5bc6\u3001\u77ed\u4fe1\u3001\u65e7\u8bbe\u5907\u626b\u7801\u548c\u540c\u4e8b\u8f85\u52a9\u8ba4\u8bc1\uff1b\n3.\u8d1f\u8d23\u5f00\u53d1\u5b9e\u73b0\u5e38\u7528\u8bbe\u5907\u7ba1\u7406\u80fd\u529b\u53ca\u76f8\u5173\u4ea4\u4e92\u754c\u9762\u7684\u5f00\u53d1\u3002\"\"\" ;\n                   ex:source_mapping \"\u539f\u59cb\u88686 \u670d\u52a1\u5185\u5bb9\" ;\n                   rdfs:comment \"\u670d\u52a1\u7684\u5177\u4f53\u5185\u5bb9\uff0c\u63cf\u8ff0\" ;\n                   rdfs:label \"\u670d\u52a1\u5185\u5bb9\" .\n\n\n###  http://datahub/cost#service_cost_source\nex:service_cost_source rdf:type owl:DatatypeProperty ,\n                                owl:FunctionalProperty ;\n                       rdfs:domain ex:service ;\n                       rdfs:range xsd:string ;\n                       ex:examples \"\u9500\u552e\u627f\u62c5\" ;\n                       ex:source_mapping \"\u539f\u59cb\u88686 F\u5217\u9884\u7b97\u6620\u5c04ID\uff0c\u7ed3\u5c3e\u4e3a1.X\u30012.X\u4e3a\u516c\u53f8\u627f\u62c5\uff1b\u7ed3\u5c3e\u4e3a3.X\u30014.X\u4e3a\u9500\u552e\u627f\u62c5\" ;\n                       rdfs:comment \"\u670d\u52a1\u7684\u8d39\u7528\u662f\u9500\u552e\u627f\u62c5\u8fd8\u662f\u516c\u53f8\u627f\u62c5\" ;\n                       rdfs:label \"\u8d39\u7528\u6765\u6e90\" .\n\n\n###  http://datahub/cost#service_create_time\nex:service_create_time rdf:type owl:DatatypeProperty ,\n                                owl:FunctionalProperty ;\n                       rdfs:domain ex:service ;\n                       rdfs:range xsd:dateTime ;\n                       ex:examples \"2025-09-26 11:23\" ;\n                       ex:source_mapping \"\u539f\u59cb\u88686 \u521b\u5efa\u65e5\u671f\" ;\n                       rdfs:comment \"\u53d1\u8d77\u6b64\u6b21\u670d\u52a1\u7533\u8bf7\u7684\u65f6\u95f4\" ;\n                       rdfs:label \"\u670d\u52a1\u5355\u521b\u5efa\u65f6\u95f4\" .\n\n\n###  http://datahub/cost#service_customer_type\nex:service_customer_type rdf:type owl:DatatypeProperty ,\n                                  owl:FunctionalProperty ;\n                         rdfs:domain ex:service ;\n                         rdfs:range xsd:string ;\n                         ex:source_mapping \"\u539f\u59cb\u88686 AD\u5217 \u670d\u52a1\u7c7b\u578b \u5e76\u5c06\u201c\u5355\u5ba2\u6237\u9a7b\u573a\u670d\u52a1\u201d\u6620\u5c04\u4e3a\u201c\u5355\u5ba2\u6237\u670d\u52a1\u201d\uff0c\u201c\u591a\u5ba2\u6237\u8fdc\u7a0b\u670d\u52a1\u201d\u6620\u5c04\u4e3a\u201c\u591a\u5ba2\u6237\u670d\u52a1\u201d\" ;\n                         rdfs:comment \"\u7528\u4e8e\u8bf4\u660e\u670d\u52a1\u5355\u5ba2\u6237\u8fd8\u662f\u591a\u5ba2\u6237\" ;\n                         rdfs:label \"\u670d\u52a1\u5ba2\u6237\u6570\u91cf\" .\n\n\n###  http://datahub/cost#service_estimated_cost\nex:service_estimated_cost rdf:type owl:DatatypeProperty ,\n                                   owl:FunctionalProperty ;\n                          rdfs:domain ex:service ;\n                          rdfs:range xsd:decimal ;\n                          ex:examples \"187400\" ;\n                          ex:source_mapping \"\u539f\u59cb\u88686 \u9879\u76ee\u9884\u4f30\u603b\u8d39\u7528\" ;\n                          rdfs:comment \"\u670d\u52a1\u9884\u8ba1\u4f1a\u53d1\u751f\u7684\u8d39\u7528\uff0c\u5373\u9884\u4f30\u670d\u52a1\u5b8c\u6210\u540e\uff0c\u9700\u8981\u4ed8\u7ed9\u670d\u52a1\u5546\u7684\u94b1\uff1b\u9884\u4f30\u8d39\u7528\u5e76\u6ca1\u6709\u5b9e\u9645\u53d1\u751f\uff0c\u4e0d\u5e94\u4f5c\u4e3a\u5b9e\u9645\u6210\u672c\u4f5c\u4e3a\u8ba1\u7b97\uff1b\u4e00\u4e2a\u9879\u76ee\u9884\u7b97\u4e0b\u7684\u6240\u6709\u670d\u52a1\u9884\u4f30\u8d39\u7528\u603b\u548c\uff0c\u4e0d\u5e94\u8d85\u8fc7\u9879\u76ee\u9884\u7b97\u7684\u91d1\u989d\" ;\n                          rdfs:label \"\u670d\u52a1\u9884\u4f30\u8d39\u7528\" .\n\n\n###  http://datahub/cost#service_id\nex:service_id rdf:type owl:DatatypeProperty ,\n                       owl:FunctionalProperty ;\n              rdfs:domain ex:service ;\n              rdfs:range xsd:string ;\n              ex:examples \"PR-20250926-0005\" ;\n              ex:source_mapping \"\u539f\u59cb\u88686 \u670d\u52a1\u7533\u8bf7\u7f16\u53f7\" ;\n              rdfs:comment \"\u5916\u5305\u670d\u52a1\u7684\u6807\u8bc6id\" ;\n              rdfs:label \"\u670d\u52a1\u7533\u8bf7ID\" .\n\n\n###  http://datahub/cost#service_initiator\nex:service_initiator rdf:type owl:DatatypeProperty ,\n                              owl:FunctionalProperty ;\n                     rdfs:domain ex:service ;\n                     rdfs:range xsd:string ;\n                     ex:examples \"\u6743\u5e7f\u653f\" ;\n                     ex:source_mapping \"\u539f\u59cb\u88686 \u63d0\u5355\u4eba\" ;\n                     rdfs:comment \"\u7533\u8bf7\u6b64\u6b21\u670d\u52a1\u7684\u4eba\u5458\" ;\n                     rdfs:label \"\u670d\u52a1\u53d1\u8d77\u4eba\" .\n\n\n###  http://datahub/cost#service_initiator_dept\nex:service_initiator_dept rdf:type owl:DatatypeProperty ,\n                                   owl:FunctionalProperty ;\n                          rdfs:domain ex:service ;\n                          rdfs:range xsd:string ;\n                          ex:examples \"\u5927\u5ba2\u7279\u79cd\u5ba2\u6210\u7ec4\" ;\n                          ex:source_mapping \"\u539f\u59cb\u88686 \u63d0\u5355\u4eba\u90e8\u95e8\" ;\n                          rdfs:comment \"\u7533\u8bf7\u6b64\u6b21\u670d\u52a1\u7684\u4eba\u5458\u6240\u5728\u90e8\u95e8\" ;\n                          rdfs:label \"\u670d\u52a1\u53d1\u8d77\u4eba\u6240\u5728\u90e8\u95e8\" .\n\n\n###  http://datahub/cost#service_mode\nex:service_mode rdf:type owl:DatatypeProperty ,\n                         owl:FunctionalProperty ;\n                rdfs:domain ex:service ;\n                rdfs:range xsd:string ;\n                ex:examples \"\u9879\u76ee\u6574\u5305\" ;\n                ex:source_mapping \"\u539f\u59cb\u88686 \u670d\u52a1\u6a21\u5f0f\" ;\n                rdfs:comment \"\u53ef\u80fd\u662f\u201c\u9879\u76ee\u6574\u5305\u201d\u6216\u201c\u4eba\u5458\u5916\u5305\u201d\uff0c\u9879\u76ee\u6574\u5305\u5373\u901a\u8fc7\u6b64\u6b21\u670d\u52a1\u4e3a\u5355\u4e2a\u9879\u76ee\u89e3\u51b3\u67d0\u4e2a\u660e\u786e\u9700\u6c42\uff1b\u4eba\u5458\u5916\u5305\u5373\u901a\u8fc7\u6b64\u6b21\u670d\u52a1\u4e3a\u5355\u4e2a\u6216\u591a\u4e2a\u9879\u76ee\u63d0\u4f9b\u6280\u672f\u4eba\u5458\u9a7b\u573a\uff0c\u89e3\u51b3\u4e00\u7cfb\u5217\u95ee\u9898\" ;\n                rdfs:label \"\u670d\u52a1\u6a21\u5f0f\" .\n\n\n###  http://datahub/cost#service_provider\nex:service_provider rdf:type owl:DatatypeProperty ,\n                             owl:FunctionalProperty ;\n                    rdfs:domain ex:task ;\n                    rdfs:range xsd:string ;\n                    ex:examples \"\u6b66\u6c49\u4e0a\u4e91\u7231\u529e\u516c\u6570\u5b57\u79d1\u6280\u6709\u9650\u516c\u53f8\" ;\n                    ex:source_mapping \"\u539f\u59cb\u88683 \u627f\u63a5\u670d\u52a1\u5546\u3001\u539f\u59cb\u88685 \u670d\u52a1\u5546\" ;\n                    rdfs:comment \"\u627f\u63a5\u8be5\u4efb\u52a1\u7684\u670d\u52a1\u5546\" ;\n                    rdfs:label \"\u627f\u63a5\u670d\u52a1\u5546\" .\n\n\n###  http://datahub/cost#service_province\nex:service_province rdf:type owl:DatatypeProperty ,\n                             owl:FunctionalProperty ;\n                    rdfs:domain ex:service ;\n                    rdfs:range xsd:string ;\n                    ex:examples \"\u5317\u4eac\u5e02\" ;\n                    ex:source_mapping \"\u539f\u59cb\u88686 \u7701\u4efd\" ;\n                    rdfs:comment \"\u670d\u52a1\u7684\u9879\u76ee\u6240\u5728\u7701\u4efd\" ;\n                    rdfs:label \"\u670d\u52a1\u6240\u5728\u7701\u4efd\" .\n\n\n###  http://datahub/cost#service_stage_status\nex:service_stage_status rdf:type owl:DatatypeProperty ,\n                                 owl:FunctionalProperty ;\n                        rdfs:domain ex:service ;\n                        rdfs:range xsd:string ;\n                        ex:examples \"\u4ea4\u4ed8\u9636\u6bb5\" ;\n                        ex:source_mapping \"\u539f\u59cb\u88686 \u9636\u6bb5\u72b6\u6001\" ;\n                        rdfs:comment \"\u8bf4\u660e\u670d\u52a1\u8fdb\u884c\u5230\u4e86\u54ea\u4e2a\u9636\u6bb5\" ;\n                        rdfs:label \"\u670d\u52a1\u9636\u6bb5\u72b6\u6001\" .\n\n\n###  http://datahub/cost#service_tags\nex:service_tags rdf:type owl:DatatypeProperty ,\n                         owl:FunctionalProperty ;\n                rdfs:domain ex:service ;\n                rdfs:range xsd:string ;\n                ex:examples \"\u79c1\u6709\u4e91\u4ea7\u54c1\u5b9a\u5236\u5f00\u53d1\" ;\n                ex:source_mapping \"\u539f\u59cb\u88686 \u6807\u7b7e\" ;\n                rdfs:comment \"\u5bf9\u67d0\u4e9b\u7279\u522b\u5173\u6ce8\u7684\u670d\u52a1\u5185\u5bb9\uff0c\u4ee5\u6807\u7b7e\u7684\u65b9\u5f0f\u533a\u5206\u51fa\u6765\" ;\n                rdfs:label \"\u670d\u52a1\u6807\u7b7e\" .\n\n\n###  http://datahub/cost#service_theme\nex:service_theme rdf:type owl:DatatypeProperty ,\n                          owl:FunctionalProperty ;\n                 rdfs:domain ex:service ;\n                 rdfs:range xsd:string ;\n                 ex:examples \"\u4e2d\u6838\u534e\u8f89\u534f\u4f5c\u9879\u76ee\u53cc\u56e0\u5b50\u8ba4\u8bc1\u4e8c\u5f00\u670d\u52a1\u5355\u7533\u8bf7\" ;\n                 ex:source_mapping \"\u539f\u59cb\u88686 \u670d\u52a1\u7533\u8bf7\u4e3b\u9898\" ;\n                 rdfs:comment \"\u5916\u5305\u670d\u52a1\u7684\u4e3b\u8981\u5185\u5bb9\u63cf\u8ff0\" ;\n                 rdfs:label \"\u670d\u52a1\u7533\u8bf7\u4e3b\u9898\" .\n\n\n###  http://datahub/cost#service_type_id\nex:service_type_id rdf:type owl:DatatypeProperty ,\n                            owl:FunctionalProperty ;\n                   rdfs:domain ex:service_type ;\n                   rdfs:range xsd:string ;\n                   ex:source_mapping \"\u81ea\u751f\u6210\" ;\n                   rdfs:comment \"\u670d\u52a1\u7c7b\u578b\u7684\u6807\u8bc6id\uff1b\" ;\n                   rdfs:label \"\u670d\u52a1\u7c7b\u578bID\" .\n\n\n###  http://datahub/cost#service_type_level\nex:service_type_level rdf:type owl:DatatypeProperty ,\n                               owl:FunctionalProperty ;\n                      rdfs:domain ex:service_type ;\n                      rdfs:range xsd:string ;\n                      ex:examples \"\u4e8c\u7ea7\" ;\n                      ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u7c7b\u578b\" ;\n                      rdfs:comment \"\u670d\u52a1\u7c7b\u578b\u7684\u7ea7\u522b\uff0c\u5f53\u524d\u5171\u6709\u4e24\u7ea7\uff1a\u4e00\u7ea7\u548c\u4e8c\u7ea7\uff1b\u4e00\u7ea7\u670d\u52a1\u7c7b\u578b\u5305\u542b\u591a\u4e2a\u4e8c\u7ea7\u670d\u52a1\u7c7b\u578b\" ;\n                      rdfs:label \"\u670d\u52a1\u7c7b\u578b\u7ea7\u522b\" .\n\n\n###  http://datahub/cost#service_type_name\nex:service_type_name rdf:type owl:DatatypeProperty ,\n                              owl:FunctionalProperty ;\n                     rdfs:domain ex:service_type ;\n                     rdfs:range xsd:string ;\n                     ex:examples \"\u6807\u51c6\u8d26\u53f7\u5bf9\u63a5\" ;\n                     ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u7c7b\u578b\" ;\n                     rdfs:comment \"\u670d\u52a1\u7c7b\u578b\u7684\u540d\u79f0\uff0c\u7528\u4e8e\u516c\u53f8\u5185\u90e8\u7684\u7edf\u8ba1\" ;\n                     rdfs:label \"\u670d\u52a1\u7c7b\u578b\u540d\u79f0\" .\n\n\n###  http://datahub/cost#service_used_amount\nex:service_used_amount rdf:type owl:DatatypeProperty ,\n                                owl:FunctionalProperty ;\n                       rdfs:domain ex:service ;\n                       rdfs:range xsd:decimal ;\n                       ex:examples \"1138590\" ;\n                       ex:source_mapping \"\u539f\u59cb\u88686 \u670d\u52a1\u7533\u8bf7\u5df2\u4f7f\u7528\u91d1\u989d\" ;\n                       rdfs:comment \"\u57fa\u4e8e\u8fd9\u4e2a\u670d\u52a1\u5df2\u7ecf\u53d1\u8d771\u4e2a\u6216\u591a\u4e2a\u4efb\u52a1\uff0c\u6240\u6709\u4efb\u52a1\u7684\u603b\u91d1\u989d\u5373\u4e3a\u670d\u52a1\u7684\u5df2\u4f7f\u7528\u91d1\u989d\" ;\n                       rdfs:label \"\u670d\u52a1\u5df2\u4f7f\u7528\u91d1\u989d\" .\n\n\n###  http://datahub/cost#settlement_terms\nex:settlement_terms rdf:type owl:DatatypeProperty ,\n                             owl:FunctionalProperty ;\n                    rdfs:domain ex:service ;\n                    rdfs:range xsd:string ;\n                    ex:examples \"\"\"\u9636\u6bb5\u6027\u9a8c\u6536\u7ed3\u7b97\uff1a\n\u521d\u9a8c\uff1a\u9879\u76ee\u6210\u679c\u4ea4\u4ed8\u7269+\u4ea4\u4ed8\u5185\u90e8\u9a8c\u6536\u5355 20.0%\n\u7ec8\u9a8c\uff1a\u5ba2\u6237\u56de\u6267\u5355/\u90ae\u4ef6 75.0%\n\u7ef4\u4fdd\uff1a\u7ef4\u4fdd\u5185\u90e8\u9a8c\u6536\u5355 5.0%\"\"\" ;\n                    ex:source_mapping \"\u539f\u59cb\u88686 \u7ed3\u7b97\u6761\u6b3e\" ;\n                    rdfs:comment \"\u670d\u52a1\u6700\u7ec8\u7ed3\u7b97\u65f6\u7684\u89c4\u5219\" ;\n                    rdfs:label \"\u7ed3\u7b97\u6761\u6b3e\" .\n\n\n###  http://datahub/cost#task_Engineer__Level\nex:task_Engineer__Level rdf:type owl:DatatypeProperty ,\n                                 owl:FunctionalProperty ;\n                        rdfs:domain ex:task ;\n                        rdfs:range xsd:string ;\n                        ex:source_mapping \"\u539f\u59cb\u88685 \u7b7e\u7ea6\u72b6\u6001 W\u5217\u5c97\u4f4d\u7ea7\u522b\" ;\n                        rdfs:comment \"\u4ec5\u4eba\u5458\u5916\u5305\u7684\u4efb\u52a1\u6d89\u53ca\uff0c\u6307\u6d3e\u53d1\u7684\u5916\u5305\u5de5\u7a0b\u5e08\u5c97\u4f4d\u7ea7\u522b\" ;\n                        rdfs:label \"\u4efb\u52a1\u5de5\u7a0b\u5e08\u5c97\u4f4d\u7ea7\u522b\" .\n\n\n###  http://datahub/cost#task_Engineer_name\nex:task_Engineer_name rdf:type owl:DatatypeProperty ,\n                               owl:FunctionalProperty ;\n                      rdfs:domain ex:task ;\n                      rdfs:range xsd:string ;\n                      ex:source_mapping \"\u539f\u59cb\u88685 \u7b7e\u7ea6\u72b6\u6001 U\u5217\u5de5\u7a0b\u5e08\u59d3\u540d\" ;\n                      rdfs:comment \"\u4ec5\u4eba\u5458\u5916\u5305\u7684\u4efb\u52a1\u6d89\u53ca\uff0c\u6307\u6d3e\u53d1\u7ed9\u54ea\u4f4d\u5916\u5305\u5de5\u7a0b\u5e08\uff0c\u4e00\u4e2a\u4efb\u52a1\u4ec5\u9488\u5bf9\u4e00\u4f4d\u5de5\u7a0b\u5e08\" ;\n                      rdfs:label \"\u4efb\u52a1\u5de5\u7a0b\u5e08\u59d3\u540d\" .\n\n\n###  http://datahub/cost#task_Engineer_title\nex:task_Engineer_title rdf:type owl:DatatypeProperty ,\n                                owl:FunctionalProperty ;\n                       rdfs:domain ex:task ;\n                       rdfs:range xsd:string ;\n                       ex:source_mapping \"\u539f\u59cb\u88685 \u7b7e\u7ea6\u72b6\u6001 V\u5217\u5c97\u4f4d\u540d\u79f0\" ;\n                       rdfs:comment \"\u4ec5\u4eba\u5458\u5916\u5305\u7684\u4efb\u52a1\u6d89\u53ca\uff0c\u6307\u6d3e\u53d1\u7684\u5916\u5305\u5de5\u7a0b\u5e08\u5c97\u4f4d\u540d\u79f0\" ;\n                       rdfs:label \"\u4efb\u52a1\u5de5\u7a0b\u5e08\u5c97\u4f4d\u540d\u79f0\" .\n\n\n###  http://datahub/cost#task_amount\nex:task_amount rdf:type owl:DatatypeProperty ,\n                        owl:FunctionalProperty ;\n               rdfs:domain ex:task ;\n               rdfs:range xsd:decimal ;\n               ex:examples \"187400\" ;\n               ex:source_mapping \"\u539f\u59cb\u88683 \u9879\u76ee\u91d1\u989d\uff08BI\u7528\uff09\u3001 \u539f\u59cb\u88685 N\u5217\u670d\u52a1\u603b\u91d1\u989d\uff080609\uff09\" ;\n               rdfs:comment \"\"\"\\\"\u5bf9\u4e8e\u6574\u5305\u4efb\u52a1\uff0c\u5373\u4e3a\u4efb\u52a1\u5b9e\u9645\u82b1\u8d39\u7684\u91d1\u989d\uff0c\u5dee\u65c5\u8d39\u7528\u5df2\u8ba1\u7b97\u5728\u5185\uff0c\u53ea\u6709\u8be5\u91d1\u989d\u624d\u5b9e\u9645\u53d1\u751f\u4e86\uff0c\u53ef\u4f5c\u4e3a\u6574\u5305\u670d\u52a1\u7684\u6210\u672c\u8ba1\u7b97\uff1b\n\u5bf9\u4e8e\u4eba\u5458\u5916\u5305\u4efb\u52a1\uff0c\u8be5\u9879\u4ec5\u4e3a\u9884\u4f30\u7684\u6210\u672c\uff0c\u5305\u542b\u9884\u4f30\u7684\u5de5\u7a0b\u5e08\u603b\u4ef7\u4e0e\u5dee\u65c5\u8d39\u7528\uff0c\u5b9e\u9645\u53d1\u751f\u7684\u6210\u672c\u9700\u8981\u6309\u7167\u4efb\u52a1\u6bcf\u4e2a\u6708\u5bf9\u5e94\u7684\u4efb\u52a1\u9a8c\u6536\u91d1\u989d\u53bb\u8ba1\u7b97\\\"\"\"\" ;\n               rdfs:label \"\u4efb\u52a1\u91d1\u989d\" .\n\n\n###  http://datahub/cost#task_approval_status\nex:task_approval_status rdf:type owl:DatatypeProperty ,\n                                 owl:FunctionalProperty ;\n                        rdfs:domain ex:task ;\n                        rdfs:range xsd:string ;\n                        ex:examples \"\u5ba1\u6279\u4e2d\" ;\n                        ex:source_mapping \"\u539f\u59cb\u88683\u3001\u539f\u59cb\u88685 \u5ba1\u6279\u72b6\u6001\" ;\n                        rdfs:comment \"\u4efb\u52a1\u662f\u5426\u5728\u516c\u53f8\u5185\u5ba1\u6279\u901a\u8fc7\uff0c\u5ba1\u6279\u901a\u8fc7\u540e\u624d\u53ef\u4e0e\u670d\u52a1\u5546\u6b63\u5f0f\u7b7e\u7ea6\uff0c\u8ba1\u7b97\u67d0\u4e2a\u5468\u671f\u6216\u7ef4\u5ea6\u7684\u670d\u52a1\u8d39\u7528\u65f6\uff0c\u4e0d\u7528\u8003\u8651\u4efb\u52a1\u7684\u5ba1\u6279\u72b6\u6001\" ;\n                        rdfs:label \"\u4efb\u52a1\u5ba1\u6279\u72b6\u6001\" .\n\n\n###  http://datahub/cost#task_create_time\nex:task_create_time rdf:type owl:DatatypeProperty ,\n                             owl:FunctionalProperty ;\n                    rdfs:domain ex:task ;\n                    rdfs:range xsd:dateTime ;\n                    ex:examples \"2025-10-19 16:46\" ;\n                    ex:source_mapping \"\u539f\u59cb\u88683\u3001\u539f\u59cb\u88685 \u521b\u5efa\u65e5\u671f\" ;\n                    rdfs:comment \"\u521b\u5efa\u4efb\u52a1\u7684\u65f6\u95f4\" ;\n                    rdfs:label \"\u4efb\u52a1\u521b\u5efa\u65f6\u95f4\" .\n\n\n###  http://datahub/cost#task_creator\nex:task_creator rdf:type owl:DatatypeProperty ,\n                         owl:FunctionalProperty ;\n                rdfs:domain ex:task ;\n                rdfs:range xsd:string ;\n                ex:examples \"\u5468\u4e911\" ;\n                ex:source_mapping \"\u539f\u59cb\u88683 \u521b\u5efa\u4eba\u3001\u539f\u59cb\u88685 \u4fee\u6539\u4eba\" ;\n                rdfs:comment \"\u521b\u5efa\u4efb\u52a1\u7684\u53d1\u8d77\u4eba\" ;\n                rdfs:label \"\u4efb\u52a1\u521b\u5efa\u4eba\" .\n\n\n###  http://datahub/cost#task_date\nex:task_date rdf:type owl:DatatypeProperty ,\n                      owl:FunctionalProperty ;\n             rdfs:domain ex:task ;\n             rdfs:range xsd:date ;\n             ex:examples \"2025-10-19\" ;\n             ex:source_mapping \"\u539f\u59cb\u88683 \u4efb\u52a1\u4e66\u5f52\u5c5e\u65e5\u671f\" ;\n             rdfs:comment \"\u6574\u5305\u4efb\u52a1\u53d1\u751f\u7684\u65f6\u95f4\uff0c\u6574\u5305\u4efb\u52a1\u7684\u8d39\u7528\u6210\u672c\u6309\u7167\u8be5\u5b57\u6bb5\u8ba1\u7b97\u5f52\u5c5e\u5468\u671f\" ;\n             rdfs:label \"\u6574\u5305\u4efb\u52a1\u5f52\u5c5e\u65e5\u671f\" .\n\n\n###  http://datahub/cost#task_end_time\nex:task_end_time rdf:type owl:DatatypeProperty ,\n                          owl:FunctionalProperty ;\n                 rdfs:domain ex:task ;\n                 rdfs:range xsd:date ;\n                 ex:examples \"2025-10-24\" ;\n                 ex:source_mapping \"\u539f\u59cb\u88683\u3001\u539f\u59cb\u88685 \u7ed3\u675f\u65f6\u95f4\" ;\n                 rdfs:comment \"\u8be5\u4efb\u52a1\u9884\u8ba1\u5b8c\u6210\u7684\u65f6\u95f4\" ;\n                 rdfs:label \"\u4efb\u52a1\u7ed3\u675f\u65f6\u95f4\" .\n\n\n###  http://datahub/cost#task_id\nex:task_id rdf:type owl:DatatypeProperty ,\n                    owl:FunctionalProperty ;\n           rdfs:domain ex:task ;\n           rdfs:range xsd:string ;\n           ex:examples \"TB-20251019003\" ;\n           ex:source_mapping \"\u539f\u59cb\u88683 \u3001 \u539f\u59cb\u88685 \u4efb\u52a1\u4e66\u7f16\u53f7\" ;\n           rdfs:comment \"\u4efb\u52a1\u7684\u6807\u8bc6id\" ;\n           rdfs:label \"\u4efb\u52a1ID\" .\n\n\n###  http://datahub/cost#task_name\nex:task_name rdf:type owl:DatatypeProperty ,\n                      owl:FunctionalProperty ;\n             rdfs:domain ex:task ;\n             rdfs:range xsd:string ;\n             ex:examples \"\u5317\u4eac\u4e2d\u6838\u534e\u8f89\u79d1\u6280\u53d1\u5c55\u6709\u9650\u516c\u53f8\u79c1\u6709\u4e91\u4ea7\u54c1\u5b9a\u5236\u5f00\u53d1\u4efb\u52a1\u4e66\" ;\n             ex:source_mapping \"\u539f\u59cb\u88683  \u4efb\u52a1\u4e66\u540d\u79f0\u3001 \u539f\u59cb\u88685 \u5de5\u7a0b\u5e08\u4efb\u52a1\" ;\n             rdfs:comment \"\u4efb\u52a1\u7684\u540d\u79f0\uff0c\u5927\u6982\u8bf4\u660e\u4efb\u52a1\u8981\u505a\u4ec0\u4e48\" ;\n             rdfs:label \"\u4efb\u52a1\u540d\u79f0\" .\n\n\n###  http://datahub/cost#task_sign_status\nex:task_sign_status rdf:type owl:DatatypeProperty ,\n                             owl:FunctionalProperty ;\n                    rdfs:domain ex:task ;\n                    rdfs:range xsd:string ;\n                    ex:examples \"\u672a\u7b7e\u7ea6\" ;\n                    ex:source_mapping \"\u539f\u59cb\u88683\u3001\u539f\u59cb\u88685 \u5ba1\u6279\u72b6\u6001\" ;\n                    rdfs:comment \"\u662f\u5426\u5df2\u7ecf\u548c\u670d\u52a1\u5546\u7b7e\u7ea6\" ;\n                    rdfs:label \"\u4efb\u52a1\u7b7e\u7ea6\u72b6\u6001\" .\n\n\n###  http://datahub/cost#task_start_time\nex:task_start_time rdf:type owl:DatatypeProperty ,\n                            owl:FunctionalProperty ;\n                   rdfs:domain ex:task ;\n                   rdfs:range xsd:date ;\n                   ex:examples \"2025-09-08\" ;\n                   ex:source_mapping \"\u539f\u59cb\u88683\u3001\u539f\u59cb\u88685 \u5f00\u59cb\u65f6\u95f4\" ;\n                   rdfs:comment \"\u8be5\u4efb\u52a1\u9884\u8ba1\u5f00\u59cb\u8fdb\u884c\u7684\u65f6\u95f4\" ;\n                   rdfs:label \"\u4efb\u52a1\u5f00\u59cb\u65f6\u95f4\" .\n\n\n###  http://datahub/cost#tast_Project_Phase\nex:tast_Project_Phase rdf:type owl:DatatypeProperty ,\n                               owl:FunctionalProperty ;\n                      rdfs:domain ex:task ;\n                      rdfs:range xsd:string ;\n                      ex:source_mapping \"\"\"\\\"\u4ec5\u9488\u5bf9\u9879\u76ee\u6574\u5305\u7684\u4efb\u52a1\n\u67e5\u627e\u4e0e\u5f52\u5c5e\u65e5\u671f\u6700\u8fd1\u7684\u6b63\u7f16\u5de5\u4f5c\uff0c\u53d6\u5176\u5bf9\u5e94\u7684\u9879\u76ee\u9636\u6bb5\uff0c\u82e5\u6709\u591a\u4e2a\u9636\u6bb5\u5219\u53d6\u6700\u540e\u7684\uff1b\u82e5\u627e\u4e0d\u5230\uff0c\u5219\u53d6\u5bf9\u5e94\u9879\u76ee\u7684\u9879\u76ee\u9636\u6bb5\\\"\"\"\" ;\n                      rdfs:comment \"\"\"\\\"\u4efb\u52a1\u53d1\u8d77\u65f6\uff0c\u9879\u76ee\u6240\u5904\u7684\u9636\u6bb5\u3002\u4ec5\u9879\u76ee\u6574\u5305\u4efb\u52a1\u7684\u6210\u672c\u6309\u6b64\u9636\u6bb5\u8ba1\u7b97\u3002\u6309\u7167\u9879\u76ee\u7684\u53d1\u5c55\u987a\u5e8f\uff0c\u679a\u4e3e\u5982\u4e0b\n-\u9700\u6c42\u4ea4\u6d41\n-\u65b9\u6848\u786e\u8ba4\n-\u63a8\u52a8\u7b7e\u7ea6\n-\u6295\u4ea7\u9636\u6bb5\n-\u63a8\u5e7f\u9a8c\u6536\n-\u8fd0\u7ef4\u9636\u6bb5\\\"\"\"\" ;\n                      rdfs:label \"\u4efb\u52a1\u6240\u5c5e\u9879\u76ee\u9636\u6bb5\" .\n\n\n###  http://datahub/cost#tax_rate\nex:tax_rate rdf:type owl:DatatypeProperty ,\n                     owl:FunctionalProperty ;\n            rdfs:domain ex:task ;\n            rdfs:range xsd:decimal ;\n            ex:examples \"6%\" ;\n            ex:source_mapping \"\u539f\u59cb\u88683 \u7a0e\u7387 \u3001\u539f\u59cb\u88685 L\u5217\u7a0e\u7387\" ;\n            rdfs:comment \"\u8d39\u7528\u7684\u6838\u7b97\u7a0e\u7387\" ;\n            rdfs:label \"\u7a0e\u7387\" .\n\n\n###  http://datahub/cost#travel_expense\nex:travel_expense rdf:type owl:DatatypeProperty ,\n                           owl:FunctionalProperty ;\n                  rdfs:domain ex:task ;\n                  rdfs:range xsd:decimal ;\n                  ex:examples \"0\" ;\n                  ex:source_mapping \"\u539f\u59cb\u88683 \u5dee\u65c5\u8d39\u7528\" ,\n                                    \"\u539f\u59cb\u88683 \u5dee\u65c5\u8d39\u7528 \u3001\u539f\u59cb\u88685 AS\u5217\u5dee\u65c5\u670d\u52a1\u603b\u91d1\u989d\" ;\n                  rdfs:comment \"\u4efb\u52a1\u91d1\u989d\u4e2d\uff0c\u5dee\u65c5\u8d39\u7528\u7684\u82b1\u8d39\" ;\n                  rdfs:label \"\u5dee\u65c5\u8d39\u7528\" .\n\n\n###  http://datahub/cost#urgency_level\nex:urgency_level rdf:type owl:DatatypeProperty ,\n                          owl:FunctionalProperty ;\n                 rdfs:domain ex:service ;\n                 rdfs:range xsd:string ;\n                 ex:examples \"\u7d27\u6025\uff0c\u63a8\u5e7f\u524d\u9700\u4e0a\u7ebf\u9700\u6c42\" ;\n                 ex:source_mapping \"\u539f\u59cb\u88686 \u7d27\u6025\u7a0b\u5ea6\u8bf4\u660e\" ;\n                 rdfs:comment \"\u8bf4\u660e\u670d\u52a1\u7684\u7d27\u6025\u7a0b\u5ea6\uff0c\u662f\u5426\u9700\u8981\u5c3d\u5feb\u4ea4\u4ed8\" ;\n                 rdfs:label \"\u7d27\u6025\u7a0b\u5ea6\" .\n\n\n###  http://datahub/cost#\u9a8c\u6536\u6838\u7b97\u540e\u7684\u6210\u672c\u8d39\u7528\u4e2d\uff0c\u5dee\u65c5\u8d39\u662f\u591a\u5c11\nex:\u9a8c\u6536\u6838\u7b97\u540e\u7684\u6210\u672c\u8d39\u7528\u4e2d\uff0c\u5dee\u65c5\u8d39\u662f\u591a\u5c11 rdf:type owl:DatatypeProperty ,\n                               owl:FunctionalProperty ;\n                      rdfs:domain ex:contractor_work_acceptance ;\n                      rdfs:range xsd:decimal ;\n                      ex:source_mapping \"\u539f\u59cb\u886811 P\u5217 \u9a8c\u6536\u4eba\u5929\u6570\" ;\n                      rdfs:comment \"\u7ecf\u8fc7\u9a8c\u6536\u6838\u7b97\uff0c\u8be5\u4efb\u52a1\u5b9e\u9645\u53d1\u751f\u7684\u5de5\u4f5c\u91cf\uff0c\u5355\u4f4d\u4e3a\u4eba\u5929\" ;\n                      rdfs:label \"\u9a8c\u6536\u5de5\u65f6\" .\n\n\n#################################################################\n#    Classes\n#################################################################\n\n###  http://datahub/cost#contractor_work\nex:contractor_work rdf:type owl:Class ;\n                   rdfs:subClassOf [ rdf:type owl:Restriction ;\n                                     owl:onProperty ex:contractor_work_Date ;\n                                     owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                     owl:onDataRange xsd:date\n                                   ] ,\n                                   [ rdf:type owl:Restriction ;\n                                     owl:onProperty ex:contractor_work_Description ;\n                                     owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                     owl:onDataRange xsd:string\n                                   ] ,\n                                   [ rdf:type owl:Restriction ;\n                                     owl:onProperty ex:contractor_work_Engineer ;\n                                     owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                     owl:onDataRange xsd:string\n                                   ] ,\n                                   [ rdf:type owl:Restriction ;\n                                     owl:onProperty ex:contractor_work_Method ;\n                                     owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                     owl:onDataRange xsd:string\n                                   ] ,\n                                   [ rdf:type owl:Restriction ;\n                                     owl:onProperty ex:contractor_work_Type ;\n                                     owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                     owl:onDataRange xsd:string\n                                   ] ,\n                                   [ rdf:type owl:Restriction ;\n                                     owl:onProperty ex:contractor_work_Vendor ;\n                                     owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                     owl:onDataRange xsd:string\n                                   ] ,\n                                   [ rdf:type owl:Restriction ;\n                                     owl:onProperty ex:contractor_work__Project_Phase ;\n                                     owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                     owl:onDataRange xsd:string\n                                   ] ,\n                                   [ rdf:type owl:Restriction ;\n                                     owl:onProperty ex:contractor_work_cost ;\n                                     owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                     owl:onDataRange xsd:decimal\n                                   ] ,\n                                   [ rdf:type owl:Restriction ;\n                                     owl:onProperty ex:contractor_work_hours_Ratio ;\n                                     owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                     owl:onDataRange xsd:decimal\n                                   ] ,\n                                   [ rdf:type owl:Restriction ;\n                                     owl:onProperty ex:contractor_work_hours_acceptance ;\n                                     owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                     owl:onDataRange xsd:decimal\n                                   ] ,\n                                   [ rdf:type owl:Restriction ;\n                                     owl:onProperty ex:contractor_work_hours_reported ;\n                                     owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                     owl:onDataRange xsd:decimal\n                                   ] ,\n                                   [ rdf:type owl:Restriction ;\n                                     owl:onProperty ex:contractor_work_id ;\n                                     owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                     owl:onDataRange xsd:string\n                                   ] ;\n                   ex:description \"\u5916\u5305\u5458\u5de5\u5728\u67d0\u4e00\u65e5\uff0c\u53d1\u751f\u4e86\u5bf9\u67d0\u4e2a\u9879\u76ee\u7684\u5de5\u4f5c\u6295\u5165\uff0c\u4ea7\u751f\u5de5\u65f6\u4e0e\u6210\u672c\" ;\n                   ex:rules \"\u5916\u5305\u5de5\u65f6\u5148\u7531\u5de5\u7a0b\u5e08\u4e0a\u62a5\uff0c\u6211\u4eec\u518d\u8fdb\u884c\u9a8c\u6536\uff0c\u7ecf\u8fc7\u9a8c\u6536\u7684\u5de5\u65f6\u4e0e\u6210\u672c\u624d\u662f\u5b9e\u9645\u53d1\u751f\u7684\" ;\n                   ex:source_mapping \"\u539f\u59cb\u8868X \u670d\u52a1\u5546\u65e5\u62a5-\u5de5\u7a0b\u5e08\u65e5\u62a5\u660e\u7ec6 \u65e5\u62a5\u660e\u7ec6\u540d\u79f0\" ;\n                   rdfs:comment \"\u5916\u5305\u5458\u5de5\u5728\u9879\u76ee\u4e0a\u6295\u5165\u4e86\u5de5\u4f5c\" ;\n                   rdfs:label \"\u5916\u5305\u5de5\u4f5c\" .\n\n\n###  http://datahub/cost#contractor_work_acceptance\nex:contractor_work_acceptance rdf:type owl:Class ;\n                              rdfs:subClassOf [ rdf:type owl:Restriction ;\n                                                owl:onProperty ex:contractor_work_acceptance_content ;\n                                                owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                                owl:onDataRange xsd:string\n                                              ] ,\n                                              [ rdf:type owl:Restriction ;\n                                                owl:onProperty ex:contractor_work_acceptance_id ;\n                                                owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                                owl:onDataRange xsd:string\n                                              ] ,\n                                              [ rdf:type owl:Restriction ;\n                                                owl:onProperty ex:contractor_work_acceptance_month ;\n                                                owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                                owl:onDataRange xsd:string\n                                              ] ,\n                                              [ rdf:type owl:Restriction ;\n                                                owl:onProperty ex:contractor_work_acceptance_quality ;\n                                                owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                                owl:onDataRange xsd:decimal\n                                              ] ,\n                                              [ rdf:type owl:Restriction ;\n                                                owl:onProperty ex:contractor_work_acceptance_total_cost ;\n                                                owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                                owl:onDataRange xsd:decimal\n                                              ] ,\n                                              [ rdf:type owl:Restriction ;\n                                                owl:onProperty ex:contractor_work_acceptance_travel_cost ;\n                                                owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                                owl:onDataRange xsd:decimal\n                                              ] ,\n                                              [ rdf:type owl:Restriction ;\n                                                owl:onProperty ex:\u9a8c\u6536\u6838\u7b97\u540e\u7684\u6210\u672c\u8d39\u7528\u4e2d\uff0c\u5dee\u65c5\u8d39\u662f\u591a\u5c11 ;\n                                                owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                                owl:onDataRange xsd:decimal\n                                              ] ;\n                              ex:description \"\u4eba\u5458\u5916\u5305\u4efb\u52a1\uff0c\u6bcf\u4e2a\u6708\u4f1a\u4ea7\u751f\u5916\u5305\u4efb\u52a1\u9a8c\u6536\uff0c\u6838\u7b97\u672c\u6708\u5b9e\u9645\u53d1\u751f\u7684\u5de5\u65f6\u548c\u8d39\u7528\" ;\n                              ex:rules \"\u9a8c\u6536\u7684\u5de5\u7a0b\u5e08\u5e94\u4e3a\u9488\u5bf9\u9a8c\u8bc1\u9488\u5bf9\u4efb\u52a1\u4e2d\u7684\u5de5\u7a0b\u5e08\" ;\n                              ex:source_mapping \"\u539f\u59cb\u886811 \u5de5\u7a0b\u5e08\u4efb\u52a1\u9a8c\u6536\u5355\u7f16\u7801\" ;\n                              rdfs:comment \"\u5bf9\u5916\u5305\u4efb\u52a1\u8fdb\u884c\u6708\u5ea6\u9a8c\u6536\u786e\u8ba4\" ;\n                              rdfs:label \"\u5916\u5305\u4efb\u52a1\u6708\u5ea6\u9a8c\u6536\" .\n\n\n###  http://datahub/cost#corporate_budget\nex:corporate_budget rdf:type owl:Class ;\n                    rdfs:subClassOf [ rdf:type owl:Restriction ;\n                                      owl:onProperty ex:corporate_budget_id ;\n                                      owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                      owl:onDataRange xsd:string\n                                    ] ,\n                                    [ rdf:type owl:Restriction ;\n                                      owl:onProperty ex:corporate_budget_level ;\n                                      owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                      owl:onDataRange xsd:string\n                                    ] ;\n                    owl:hasKey ( ex:corporate_budget_id\n                               ) ;\n                    ex:description \"\u516c\u53f8\u9884\u7b97\u5206\u4e3a\u4e8c\u7ea7\u548c\u4e09\u7ea7\uff0c\u5176\u4e2d\u4e09\u7ea7\u9884\u7b97\u5f52\u5c5e\u4e8e\u4e8c\u7ea7\u9884\u7b97\" ;\n                    ex:rules \"\"\"\u5728\u5e74\u5ea6\u5185\uff0c\u6240\u6709\u9879\u76ee\u5728\u67d0\u4e00\u7c7b\u5916\u5305\u670d\u52a1\u4e0a\u53d1\u751f\u7684\u8d39\u7528\u603b\u548c\uff0c\u5e94\u4e0d\u8d85\u8fc7\u516c\u53f8\u9884\u7b97\n\"\"\" ;\n                    ex:source_mapping \"\u539f\u59cb\u88686 \u9884\u7b97\u6620\u5c04id\u3001\u4e8c\u7ea7\u9884\u7b97id\" ;\n                    rdfs:comment \"\u516c\u53f8\u4e3a\u67d0\u4e00\u7c7b\u670d\u52a1\u63d0\u524d\u5708\u5b9a\u7684\u5e74\u5ea6\u9884\u7b97\"@zh ;\n                    rdfs:label \"\u516c\u53f8\u9884\u7b97\"@zh .\n\n\n###  http://datahub/cost#customer\nex:customer rdf:type owl:Class ;\n            rdfs:subClassOf [ rdf:type owl:Restriction ;\n                              owl:onProperty ex:customer_id ;\n                              owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                              owl:onDataRange xsd:string\n                            ] ,\n                            [ rdf:type owl:Restriction ;\n                              owl:onProperty ex:customer_name ;\n                              owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                              owl:onDataRange xsd:string\n                            ] ;\n            owl:hasKey ( ex:customer_id\n                       ) ;\n            ex:description \"\u53ef\u80fd\u662f\u5df2\u8d2d\u4e70\u6211\u4eec\u4ea7\u54c1\uff0c\u8fbe\u6210\u5408\u4f5c\u5173\u7cfb\uff0c\u4e5f\u53ef\u80fd\u662f\u6f5c\u5728\u5ba2\u6237\uff1b\" ;\n            ex:rules \"\u5ba2\u6237\u5305\u542b\u9879\u76ee\uff0c\u6240\u6709\u4ea7\u54c1\u90fd\u57fa\u4e8e\u9879\u76ee\u4ea4\u4ed8\u7ed9\u5ba2\u6237\uff0c\u6240\u6709\u201c\u5916\u5305\u670d\u52a1\u201d\u4e5f\u57fa\u4e8e\u67d0\u4e2a\u9879\u76ee\u4e3a\u5ba2\u6237\u670d\u52a1\" ;\n            ex:source_mapping \"\u539f\u59cb\u8868PMS  G\u5217\u5ba2\u6237\u7f16\u53f7\" ;\n            rdfs:comment \"\u6211\u4eec\u7684\u5ba2\u6237\"@zh ;\n            rdfs:label \"\u5ba2\u6237\"@zh .\n\n\n###  http://datahub/cost#department\nex:department rdf:type owl:Class ;\n              rdfs:subClassOf [ rdf:type owl:Restriction ;\n                                owl:onProperty ex:dept_id ;\n                                owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                owl:onDataRange xsd:string\n                              ] ,\n                              [ rdf:type owl:Restriction ;\n                                owl:onProperty ex:dept_level ;\n                                owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                owl:onDataRange xsd:string\n                              ] ;\n              owl:hasKey ( ex:dept_id\n                         ) ;\n              ex:description \"\u53ef\u80fd\u6709\u591a\u7ea7\uff0c\u591a\u7ea7\u90e8\u95e8\u7684\u5b8c\u6574\u8def\u5f84\u8868\u793a\u4e3a\uff1aXX/XX/XX/XX\" ;\n              ex:rules \"\"\"\u6240\u6709\u5458\u5de5\u89d2\u8272\uff0c\u5982\u9879\u76ee\u8d1f\u8d23\u4eba\u3001\u9879\u76ee\u7ecf\u7406\u3001\u9500\u552e\u7b49\uff0c\u90fd\u5e94\u5c5e\u4e8e\u67d0\u4e2a\u90e8\u95e8\uff1b\n\u53ef\u6839\u636e\u67d0\u4e00\u4e2a\u90e8\u95e8\uff0c\u67e5\u627e\u5176\u4e0a\u7ea7\u90e8\u95e8\uff1b\n\u5982\u679c\u672a\u6309\u7167XX/XX/XX/XX\u63cf\u8ff0\u5b8c\u6574\u90e8\u95e8\u5c42\u7ea7\u65f6\uff0c\u9700\u6309\u7167\u90e8\u95e8\u540d\u79f0\u5bfb\u627e\u5176\u7236\u90e8\u95e8\u4e0e\u5b50\u90e8\u95e8\"\"\" ;\n              ex:source_mapping \"\u539f\u59cb\u8868X \u4e00\u7ea7\u90e8\u95e8\u3001\u4e8c\u7ea7\u90e8\u95e8\u3001\u4e09\u7ea7\u90e8\u95e8\u3001\u56db\u7ea7\u90e8\u95e8\" ;\n              rdfs:comment \"\u516c\u53f8\u5185\u90e8\u7684\u90e8\u95e8\" ;\n              rdfs:label \"\u90e8\u95e8\"@zh .\n\n\n###  http://datahub/cost#employee_work\nex:employee_work rdf:type owl:Class ;\n                 rdfs:subClassOf [ rdf:type owl:Restriction ;\n                                   owl:onProperty ex:employee_work_editor ;\n                                   owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                   owl:onDataRange xsd:string\n                                 ] ,\n                                 [ rdf:type owl:Restriction ;\n                                   owl:onProperty ex:employee_work_hours ;\n                                   owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                   owl:onDataRange xsd:decimal\n                                 ] ,\n                                 [ rdf:type owl:Restriction ;\n                                   owl:onProperty ex:employee_work_id ;\n                                   owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                   owl:onDataRange xsd:string\n                                 ] ,\n                                 [ rdf:type owl:Restriction ;\n                                   owl:onProperty ex:employee_work_method ;\n                                   owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                   owl:onDataRange xsd:string\n                                 ] ,\n                                 [ rdf:type owl:Restriction ;\n                                   owl:onProperty ex:employee_work_time ;\n                                   owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                   owl:onDataRange xsd:date\n                                 ] ,\n                                 [ rdf:type owl:Restriction ;\n                                   owl:onProperty ex:employee_work_type ;\n                                   owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                   owl:onDataRange xsd:string\n                                 ] ;\n                 ex:description \"\u6b63\u7f16\u5458\u5de5\u5728\u67d0\u4e00\u65e5\uff0c\u53d1\u751f\u4e86\u5bf9\u67d0\u4e2a\u9879\u76ee\u7684\u5de5\u4f5c\u6295\u5165\uff0c\u4ea7\u751f\u5de5\u65f6\u4e0e\u6210\u672c\" ;\n                 ex:rules \"\u901a\u8fc7\u5de5\u65f6\u6362\u7b97\u7684\u6210\u672c\uff0c\u6309\u7167\u4ee5\u4e0b\u516c\u5f0f\u8ba1\u7b97\u201c\u6210\u672c\uff08\u5143\uff09=\u5de5\u65f6\uff08\u5c0f\u65f6\uff09*231\uff08\u5143/\u5c0f\u65f6\uff09\u201d\" ;\n                 ex:source_mapping \"\u539f\u59cb\u8868X\u65e5\u62a5\u660e\u7ec6-\u65e5\u62a5\u660e\u7ec6 \u7f16\u53f7\" ;\n                 rdfs:comment \"\u6b63\u7f16\u5458\u5de5\u5728\u9879\u76ee\u4e0a\u6295\u5165\u4e86\u5de5\u4f5c\" ;\n                 rdfs:label \"\u6b63\u7f16\u5de5\u4f5c\" .\n\n\n###  http://datahub/cost#opportunity\nex:opportunity rdf:type owl:Class ;\n               rdfs:subClassOf [ rdf:type owl:Restriction ;\n                                 owl:onProperty ex:opportunity_id ;\n                                 owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                 owl:onDataRange xsd:string\n                               ] ;\n               owl:hasKey ( ex:opportunity_id\n                          ) ;\n               ex:description \"\u5546\u673a\u53ef\u80fd\u5df2\u7ecf\u8f6c\u5316\u4e3a\u4e86\u5b9e\u9645\u7684\u8ba2\u5355\uff0c\u4e5f\u6709\u53ef\u80fd\u8fd8\u5728\u8ddf\u8e2a\u4e2d\uff0c\u5e76\u672a\u53d1\u751f\u5b9e\u9645\u8d2d\u4e70\u884c\u4e3a\uff1b\" ;\n               ex:rules \"\u4e00\u4e2a\u5546\u673a\u4e0b\u6709\u53ef\u80fd\u6709\u591a\u4e2a\u8ba2\u5355\uff1b\" ;\n               ex:source_mapping \"\u539f\u59cb\u88684 \u5546\u673a\u53f7\" ;\n               rdfs:comment \"\u5ba2\u6237\u6709\u610f\u5411\u8d2d\u4e70\u6211\u4eec\u7684\u4ea7\u54c1\u65f6\uff0c\u9500\u552e\u8d1f\u8d23\u4eba\u4f1a\u5f55\u5165\u4e00\u6761\u5546\u673a\" ;\n               rdfs:label \"\u5546\u673a\"@zh .\n\n\n###  http://datahub/cost#order\nex:order rdf:type owl:Class ;\n         rdfs:subClassOf [ rdf:type owl:Restriction ;\n                           owl:onProperty ex:order_id ;\n                           owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                           owl:onDataRange xsd:string\n                         ] ;\n         owl:hasKey ( ex:order_id\n                    ) ;\n         ex:rules \"\"\"\u6bcf\u4e2a\u8ba2\u5355\u53ea\u4f1a\u5305\u542b\u4e00\u4e2a\u4ea7\u54c1\uff1b\n\u8ba2\u5355\u4e00\u5b9a\u4e0e\u67d0\u4e2a\u5546\u673a\u76f8\u5173\uff0c\u6ca1\u6709\u5546\u673a\u65e0\u6cd5\u4e0b\u8ba2\u5355\uff1b\"\"\" ;\n         ex:source_mapping \"\u539f\u59cb\u88684 \u8ba2\u5355\u53f7\" ;\n         rdfs:comment \"\u5373\u5ba2\u6237\u8d2d\u4e70\u6211\u4eec\u4ea7\u54c1\u7684\u8ba2\u5355\" ;\n         rdfs:label \"\u8ba2\u5355\"@zh .\n\n\n###  http://datahub/cost#produce_line\nex:produce_line rdf:type owl:Class ;\n                rdfs:subClassOf [ rdf:type owl:Restriction ;\n                                  owl:onProperty ex:produce_line_name ;\n                                  owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                  owl:onDataRange xsd:string\n                                ] ;\n                owl:hasKey ( ex:produce_line_name\n                           ) ;\n                ex:source_mapping \"\u539f\u59cb\u8868X \u65e5\u62a5\u660e\u7ec6-\u65e5\u62a5\u660e\u7ec6 J\u5217\u4ea7\u54c1\u6761\u7ebf\" ;\n                rdfs:comment \"\u6211\u4eec\u552e\u5356\u4ea7\u54c1\u7684\u57fa\u7840\u5206\u7c7b\" ;\n                rdfs:label \"\u4ea7\u54c1\u6761\u7ebf\" .\n\n\n###  http://datahub/cost#product\nex:product rdf:type owl:Class ;\n           rdfs:subClassOf [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:product_id ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:product_name ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ;\n           owl:hasKey ( ex:product_id\n                      ) ;\n           ex:description \"\u6211\u4eec\u5411\u5ba2\u6237\u552e\u5356\u7684\u5177\u4f53\u4ea7\u54c1SKU\" ;\n           ex:source_mapping \"\"\"\u539f\u59cb\u88684 \u4ea7\u54c1\u540d\u79f0 + \u539f\u59cb\u8868X \u65e5\u62a5\u660e\u7ec6-\u65e5\u62a5\u660e\u7ec6I\u5217\u4ea7\u54c1\u7c7b\u578b\n\u53bb\u91cd\"\"\" ;\n           rdfs:comment \"\u6211\u4eec\u5411\u5ba2\u6237\u552e\u5356\u7684\u8f6f\u4ef6\u4ea7\u54c1\" ;\n           rdfs:label \"\u4ea7\u54c1\"@zh .\n\n\n###  http://datahub/cost#product_catelogy\nex:product_catelogy rdf:type owl:Class ;\n                    rdfs:subClassOf [ rdf:type owl:Restriction ;\n                                      owl:onProperty ex:product_category_id ;\n                                      owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                      owl:onDataRange xsd:string\n                                    ] ,\n                                    [ rdf:type owl:Restriction ;\n                                      owl:onProperty ex:product_category_name ;\n                                      owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                      owl:onDataRange xsd:string\n                                    ] ;\n                    owl:hasKey ( ex:product_category_id\n                               ) ;\n                    ex:description \"\"\"\u8ba1\u7b97\u6210\u672c\u65f6\u7684\u4ea7\u54c1\u5206\u7c7b\uff0c\u6bcf\u4e2a\u5206\u7c7b\u4e0b\u5305\u542b\u591a\u79cd\u4ea7\u54c1\uff1b\n\u679a\u4e3e\u5305\u542b\uff1a\n-WPS\u7aef\n-\u516c\u6709\u4e91\n-\u8001\u7248\u79c1\u6709\u4e91\uff08\u4e0d\u542b\u4e2d\u53f0\uff09\n-\u79c1\u6709\u4e91V7\n-\u6587\u6863\u4e2d\u53f0\"\"\" ;\n                    ex:source_mapping \"\u539f\u59cb\u88684 \u6210\u672c\u4ea7\u54c1\u7ebf \" ;\n                    rdfs:comment \"\u8ba1\u7b97\u6210\u672c\u65f6\uff0c\u5bf9\u4ea7\u54c1\u7684\u5206\u7c7b\u65b9\u5f0f\" ;\n                    rdfs:label \"\u4ea7\u54c1\u6210\u672c\u7c7b\u522b\"@zh .\n\n\n###  http://datahub/cost#project\nex:project rdf:type owl:Class ;\n           rdfs:subClassOf [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:pj_leader ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:pj_manager ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:pj_starttime ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:date\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:pj_trace ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:pj_type ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:project_id ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:project_name ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ;\n           owl:hasKey ( ex:project_id\n                      ) ;\n           ex:description \"\"\"\u901a\u8fc7\u9879\u76ee\u5411\u5ba2\u6237\u4ea4\u4ed8\u4ea7\u54c1\uff0c\u9879\u76ee\u6709\u4e0d\u540c\u9636\u6bb5\u72b6\u6001\uff0c\u6309\u987a\u5e8f\u5305\u62ec\n-\u552e\u524d\u4ea4\u6d41 \n-POC\u9636\u6bb5\n-\u7b7e\u7ea6\u9636\u6bb5\n-\u6295\u4ea7\u9636\u6bb5\n-\u63a8\u5e7f\u9a8c\u6536\n-\u8fd0\u7ef4\u9636\u6bb5\"\"\" ;\n           ex:rules \"\"\"\u4e00\u4e2a\u5ba2\u6237\u53ef\u80fd\u4f1a\u6709\u591a\u4e2a\u9879\u76ee\uff1b\n\u591a\u4e2a\u9879\u76ee\u4e2d\u5305\u542b\u7684\u4ea7\u54c1\u6709\u53ef\u80fd\u4e0d\u540c\uff0c\u4e5f\u6709\u53ef\u80fd\u76f8\u540c\uff1b\n\u6240\u6709\u5916\u5305\u670d\u52a1\u90fd\u5fc5\u987b\u57fa\u4e8e\u9879\u76ee\u53d1\u8d77\u7684\uff1b\"\"\" ;\n           ex:source_mapping \"\u539f\u59cb\u8868PMS \u9879\u76ee\u7f16\u53f7 \u4e14\u6392\u9664I\u5217\u4e3a\u201c\u516c\u5171\u9879\u76ee\u201d\u7684\" ;\n           rdfs:comment \"\u6211\u4eec\u4e3a\u5ba2\u6237\u4ea4\u4ed8\u4e00\u7cfb\u5217\u4ea7\u54c1\u7684\u201c\u9879\u76ee\u201d\" ;\n           rdfs:label \"\u9879\u76ee\"@zh .\n\n\n###  http://datahub/cost#project_budget\nex:project_budget rdf:type owl:Class ;\n                  rdfs:subClassOf [ rdf:type owl:Restriction ;\n                                    owl:onProperty ex:project_budget_amount ;\n                                    owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                    owl:onDataRange xsd:decimal\n                                  ] ,\n                                  [ rdf:type owl:Restriction ;\n                                    owl:onProperty ex:project_budget_dependency_type ;\n                                    owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                    owl:onDataRange xsd:string\n                                  ] ,\n                                  [ rdf:type owl:Restriction ;\n                                    owl:onProperty ex:project_budget_id ;\n                                    owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                    owl:onDataRange xsd:string\n                                  ] ;\n                  owl:hasKey ( ex:project_budget_id\n                             ) ;\n                  ex:description \"\"\"\u8003\u8651\u5230\u9879\u76ee\u540e\u7eed\u53ef\u80fd\u4f1a\u9700\u8981\u5916\u90e8\u670d\u52a1\u5546\u652f\u6301\uff0c\u9879\u76ee\u7ecf\u7406\u53ef\u4ee5\u63d0\u524d\u7533\u8bf7\u9884\u7b97\uff1b\n\u53d1\u8d77\u670d\u52a1\u7533\u8bf7\u65f6\uff0c\u5373\u4f9d\u8d56\u8be5\u9884\u7b97\uff1b\"\"\" ;\n                  ex:rules \"\"\"\u4e00\u4e2a\u9884\u7b97\u53ef\u4ee5\u88ab\u540c\u9879\u76ee\u7684\u591a\u4e2a\u670d\u52a1\u7533\u8bf7\u4f9d\u8d56\uff1b\n\u6b63\u5e38\u60c5\u51b5\u4e0b\uff0c\u8fd9\u4e9b\u88ab\u67d0\u4e2a\u9879\u76ee\u9884\u7b97\u4f9d\u8d56\u7684\u6240\u6709\u670d\u52a1\u7684\u9884\u4f30\u8d39\u7528\u603b\u548c\u5e94\u4e0d\u8d85\u8fc7\u9879\u76ee\u9884\u7b97\u91d1\u989d\"\"\" ;\n                  ex:source_mapping \"\u539f\u59cb\u88684 \u9879\u76ee\u9884\u7b97\u660e\u7ec6\u7f16\u53f7\" ;\n                  rdfs:comment \"\u9879\u76ee\u4e3a\u53ef\u80fd\u53d1\u751f\u7684\u5916\u90e8\u670d\u52a1\u63d0\u524d\u7533\u8bf7\u7684\u9884\u7b97\" ;\n                  rdfs:label \"\u9879\u76ee\u9884\u7b97\"@zh .\n\n\n###  http://datahub/cost#service\nex:service rdf:type owl:Class ;\n           rdfs:subClassOf [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:approval_status ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:delivery_manager ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:delivery_method ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:service_cost_source ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:service_create_time ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:dateTime\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:service_customer_type ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:service_estimated_cost ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:decimal\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:service_id ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:service_initiator ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:service_initiator_dept ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:service_mode ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ,\n                           [ rdf:type owl:Restriction ;\n                             owl:onProperty ex:service_stage_status ;\n                             owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                             owl:onDataRange xsd:string\n                           ] ;\n           owl:hasKey ( ex:service_id\n                      ) ;\n           ex:description \"\u670d\u52a1\u7533\u8bf7\u53ef\u80fd\u5305\u542b\u6280\u672f\u652f\u6301\u3001\u57f9\u8bad\u3001\u8fd0\u7ef4\u3001\u4e8c\u6b21\u5f00\u53d1\u7b49\u670d\u52a1\" ;\n           ex:rules \"\"\"\u4e00\u4e2a\u9879\u76ee\u53ef\u80fd\u6709\u591a\u4e2a\u670d\u52a1\u7533\u8bf7\uff1b\n\u670d\u52a1\u7533\u8bf7\u9700\u8981\u7684\u8d39\u7528\u4f9d\u8d56\u4e8e\u9879\u76ee\u9884\u7b97\uff1b\n\u670d\u52a1\u53d1\u8d77\u65f6\uff0c\u9700\u8981\u9884\u4f30\u8d39\u7528\"\"\" ;\n           ex:source_mapping \"\u539f\u59cb\u88686 \u670d\u52a1\u7533\u8bf7\u7f16\u53f7\" ;\n           rdfs:comment \"\u5373\u5916\u5305\u670d\u52a1\u7533\u8bf7\uff0c\u67d0\u4e2a\u9879\u76ee\u9700\u8981\u5916\u5305\u652f\u6301\u65f6\uff0c\u7531\u9879\u76ee\u7ecf\u7406\u53d1\u8d77\uff0c\u5bfb\u627e\u5916\u5305\u670d\u52a1\u5546\" ;\n           rdfs:label \"\u670d\u52a1\"@zh .\n\n\n###  http://datahub/cost#service_catalogy\nex:service_catalogy rdf:type owl:Class ;\n                    rdfs:subClassOf [ rdf:type owl:Restriction ;\n                                      owl:onProperty ex:service_category_id ;\n                                      owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                      owl:onDataRange xsd:string\n                                    ] ,\n                                    [ rdf:type owl:Restriction ;\n                                      owl:onProperty ex:service_category_name ;\n                                      owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                      owl:onDataRange xsd:string\n                                    ] ;\n                    owl:hasKey ( ex:service_category_id\n                               ) ;\n                    ex:description \"\"\"\u4e3b\u8981\u7528\u4e8e\u5bf9\u5916\uff08\u670d\u52a1\u5546\uff09\u8bf4\u660e\u4efb\u52a1\u5185\u5bb9\uff1b\n\"\"\" ;\n                    ex:rules \"\u516c\u53f8\u5185\u90e8\u5bf9\u670d\u52a1\u505a\u5206\u7c7b\u7edf\u8ba1\u65f6\uff0c\u9664\u975e\u660e\u786e\u63d0\u51fa\u8981\u6309\u7167\u6b64\u5b57\u6bb5\u7edf\u8ba1\uff0c\u5426\u5219\u4e0d\u9996\u9009\u8be5\u5b57\u6bb5\uff1b\" ;\n                    ex:source_mapping \"\u539f\u59cb\u88686 \u670d\u52a1\u7c7b\u76ee\" ;\n                    rdfs:comment \"\u4e00\u79cd\u5c06\u670d\u52a1\u5185\u5bb9\u5206\u7c7b\u7684\u65b9\u5f0f\uff0c\u5728\u53d1\u8d77\u670d\u52a1\u7533\u8bf7\u4e0e\u4efb\u52a1\u65f6\u6309\u6b64\u5206\u7c7b\" ;\n                    rdfs:label \"\u670d\u52a1\u7c7b\u76ee\"@zh .\n\n\n###  http://datahub/cost#service_type\nex:service_type rdf:type owl:Class ;\n                rdfs:subClassOf [ rdf:type owl:Restriction ;\n                                  owl:onProperty ex:service_type_id ;\n                                  owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                  owl:onDataRange xsd:string\n                                ] ,\n                                [ rdf:type owl:Restriction ;\n                                  owl:onProperty ex:service_type_level ;\n                                  owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                  owl:onDataRange xsd:string\n                                ] ,\n                                [ rdf:type owl:Restriction ;\n                                  owl:onProperty ex:service_type_name ;\n                                  owl:qualifiedCardinality \"1\"^^xsd:nonNegativeInteger ;\n                                  owl:onDataRange xsd:string\n                                ] ;\n                owl:hasKey ( ex:service_type_id\n                           ) ;\n                ex:description \"\"\"\u5305\u542b\u4e24\u4e2a\u670d\u52a1\u7c7b\u578b\u7ea7\u522b\uff0c\u4e00\u7ea7\u670d\u52a1\u7c7b\u578b\u4e0b\u5305\u542b\u591a\u4e2a\u4e8c\u7ea7\u670d\u52a1\u7c7b\u578b\uff1b\n\u679a\u4e3e\u5982\u4e0b\n-\u4e13\u9879\u670d\u52a1\uff08\u5305\u542b\u7684\u4e8c\u7ea7\u670d\u52a1\u7c7b\u578b\uff1a\u4e13\u9879\u670d\u52a1-HW\u3001\u4e13\u9879\u670d\u52a1-\u706f\u5854\u3001\u4e13\u9879\u670d\u52a1-\u5347\u7ea7\uff09\n-\u6807\u51c6\u670d\u52a1\uff08\u5305\u542b\u7684\u4e8c\u7ea7\u670d\u52a1\u7c7b\u578b\uff1a\u6807\u51c6\u90e8\u7f72\u4e0e\u8fd0\u7ef4\u3001\u57f9\u8bad\u670d\u52a1\u3001\u6807\u51c6\u8d26\u53f7\u5bf9\u63a5\u3001\u8fdc\u7a0b\u652f\u6301\u670d\u52a1\uff09\n-\u5b9a\u5236\u670d\u52a1\uff08\u5305\u542b\u7684\u4e8c\u7ea7\u670d\u52a1\u7c7b\u578b\uff1a\u5b9a\u5236\u8fd0\u7ef4\u3001\u4e8c\u6b21\u5f00\u53d1\u3001\u975e\u6807\u8d26\u53f7\u5bf9\u63a5\u3001\u5ba2\u6237\u7aef\u7cfb\u7edf\u96c6\u6210\u670d\u52a1\u3001\u5ba2\u6237\u7aef\u73b0\u573a\u5b89\u88c5\u3001\u57f9\u8bad\u53ca\u5185\u5bb9\u5b9a\u5236\u3001\u79c1\u6709\u4e91\u975e\u6807\u90e8\u7f72\u3001\u9a7b\u573a\u670d\u52a1\uff09\"\"\" ;\n                ex:rules \"\u516c\u53f8\u5185\u90e8\u4e3b\u8981\u6309\u6b64\u5bf9\u5916\u5305\u670d\u52a1\u505a\u5206\u7c7b\u7edf\u8ba1\uff0c\u53ef\u4ee5\u4ece\u4e00\u7ea7\u670d\u52a1\u7c7b\u578b\u7ef4\u5ea6\u7edf\u8ba1\uff0c\u4e5f\u53ef\u4ee5\u4ece\u4e8c\u7ea7\u670d\u52a1\u7c7b\u578b\u7ef4\u5ea6\u7edf\u8ba1\uff1b\" ;\n                ex:source_mapping \"\u539f\u59cb\u8868X \u4e00\u7ea7\u670d\u52a1\u7c7b\u578b\u3001\u4e8c\u7ea7\u670d\u52a1\u7c7b\u578b\" ;\n                rdfs: